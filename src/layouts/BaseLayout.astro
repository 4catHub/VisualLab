---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  className?: string;
}

const {
  title,
  description = 'A collection of crafted visual experiments.',
  className = ''
} = Astro.props;
---
<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('visual-lab-theme');
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class={className}>
    <slot />

    {className.includes('gravity-page') && (
      <footer class="gravity-index-footer shell">
        <a href="/">Index</a>
        <span>VisualLab · 002</span>
      </footer>
    )}

    <button class="theme-toggle" id="themeToggle" type="button" aria-label="다크 모드로 전환" aria-pressed="false">
      <span class="theme-toggle__track" aria-hidden="true"><i></i></span>
      <span class="theme-toggle__label">DARK</span>
    </button>

    {className.includes('cosmic-atlas-page') && (
      <script is:inline src="/cosmic-atlas-ui.js"></script>
    )}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('themeToggle');
        if (button) {
          const label = button.querySelector('.theme-toggle__label');
          const sync = () => {
            const dark = root.dataset.theme === 'dark';
            button.setAttribute('aria-pressed', String(dark));
            button.setAttribute('aria-label', dark ? '화이트 모드로 전환' : '다크 모드로 전환');
            if (label) label.textContent = dark ? 'LIGHT' : 'DARK';
          };
          button.addEventListener('click', () => {
            const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try { localStorage.setItem('visual-lab-theme', next); } catch {}
            sync();
            window.dispatchEvent(new CustomEvent('visual-lab-theme', { detail: { theme: next } }));
          });
          sync();
        }

        const pond = document.getElementById('pond');
        if (pond && !pond.dataset.domRippleReady) {
          pond.dataset.domRippleReady = 'true';
          const makeRipple = (clientX, clientY) => {
            const rect = pond.getBoundingClientRect();
            const group = document.createElement('span');
            group.className = 'visual-ripple';
            group.style.left = `${Math.max(0, Math.min(rect.width, clientX - rect.left))}px`;
            group.style.top = `${Math.max(0, Math.min(rect.height, clientY - rect.top))}px`;
            group.innerHTML = '<i></i><i></i><i></i>';
            pond.appendChild(group);
            window.setTimeout(() => group.remove(), 2400);
          };
          pond.addEventListener('pointerdown', (event) => makeRipple(event.clientX, event.clientY));
          pond.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            const rect = pond.getBoundingClientRect();
            makeRipple(rect.left + rect.width / 2, rect.top + rect.height / 2);
          });
        }

        const lens = document.getElementById('lens');
        const orbA = document.querySelector('.home-page .orb-a');
        const orbB = document.querySelector('.home-page .orb-b');
        if (lens) {
          const moveHomeVisual = (clientX, clientY) => {
            const px = clientX / Math.max(window.innerWidth, 1);
            const py = clientY / Math.max(window.innerHeight, 1);
            lens.style.left = `${px * 100}%`;
            lens.style.top = `${py * 100}%`;
            if (orbA) {
              orbA.style.left = `${px * 100 - 22}vw`;
              orbA.style.top = `${py * 100 - 22}vh`;
            }
            if (orbB) {
              orbB.style.right = `${(1 - px) * 22 - 8}vw`;
              orbB.style.bottom = `${(1 - py) * 18 - 6}vh`;
            }
          };
          window.addEventListener('pointermove', (event) => moveHomeVisual(event.clientX, event.clientY), { passive: true });
          moveHomeVisual(window.innerWidth * .72, window.innerHeight * .34);
        }
      })();
    </script>
  </body>
</html>

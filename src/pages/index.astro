---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryPages } from '@/data/pages';
---
<BaseLayout title="VisualLab" description="Algorithms, systems, and ideas — visualized as interactive web experiments." className="home-page">
  <main class="home shell">
    <header class="topbar">
      <a class="brand" href="/">VisualLab</a>
      <span class="count">{String(galleryPages.length).padStart(2, '0')} experiments</span>
    </header>

    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">Visual experiments</p>
      <h1 id="page-title">See how it moves.</h1>
      <p>알고리즘과 시스템의 흐름을 웹 위에서 움직이는 장면으로 기록합니다.</p>
    </section>

    <nav class="experiments" aria-label="Visual experiments">
      {galleryPages.map((page, index) => (
        <a class="experiment" href={page.href}>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <span class="title">{page.title}</span>
          <span class="category">{page.category}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>

    <footer>
      <span>VisualLab</span>
      <span>Astro · Static-first</span>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(.home-page) {
    background: #080a0e;
    color: #f5f6f8;
  }

  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }

  .brand {
    font-size: .94rem;
    font-weight: 800;
    letter-spacing: -.03em;
  }

  .count,
  footer {
    color: #717783;
    font-size: .65rem;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .intro {
    padding: clamp(76px, 12vw, 150px) 0 clamp(56px, 8vw, 94px);
    max-width: 800px;
  }

  .kicker {
    margin: 0 0 18px;
    color: #75e4dd;
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.6rem);
    line-height: .9;
    letter-spacing: -.075em;
    font-weight: 720;
  }

  .intro > p:last-child {
    max-width: 540px;
    margin: 30px 0 0;
    color: #9399a5;
    line-height: 1.8;
  }

  .experiments {
    border-top: 1px solid rgba(255, 255, 255, .12);
  }

  .experiment {
    min-height: 98px;
    display: grid;
    grid-template-columns: 68px 1fr auto 34px;
    gap: 20px;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    transition: padding .25s ease, background .25s ease;
  }

  .experiment:hover {
    padding: 0 18px;
    background: rgba(255, 255, 255, .035);
  }

  .number,
  .category {
    color: #686f7c;
    font-size: .64rem;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .title {
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    font-weight: 650;
    letter-spacing: -.04em;
  }

  .category {
    text-align: right;
  }

  .arrow {
    color: #b8adff;
    font-size: 1rem;
    transition: transform .25s ease;
  }

  .experiment:hover .arrow {
    transform: translate(3px, -3px);
  }

  footer {
    margin-top: auto;
    min-height: 104px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (max-width: 640px) {
    .experiment {
      grid-template-columns: 44px 1fr 28px;
      gap: 12px;
    }

    .category {
      display: none;
    }

    .intro > p:last-child {
      max-width: 330px;
    }
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryPages } from '@/data/pages';
---
<BaseLayout title="VisualLab" description="A small collection of visual experiments, motion studies, and interactive scenes." className="home-page">
  <main class="home" id="homeStage">
    <div class="ambient" aria-hidden="true">
      <div class="wash wash-a"></div>
      <div class="wash wash-b"></div>
      <div class="grid-plane"></div>
      <div class="type-field">
        <span class="type-v">V</span>
        <span class="type-l">L</span>
        <span class="type-dot">●</span>
        <span class="active-index" id="activeIndex">00</span>
      </div>
      <div class="scanline"></div>
    </div>

    <div class="shell home-shell">
      <header class="topbar">
        <a class="brand" href="/">VisualLab</a>
        <span class="count">{String(galleryPages.length).padStart(2, '0')} experiments</span>
      </header>

      <section class="intro" aria-labelledby="page-title">
        <p class="kicker">A collection of visual experiments</p>
        <h1 id="page-title">Look.<br /><i>Move.</i><br />Stay.</h1>
        <p>색, 움직임, 공간, 계절과 작은 상호작용을 웹 위에서 실험합니다. 설명보다 장면을 먼저 보여주는 페이지들을 모읍니다.</p>
      </section>

      <nav class="experiments" aria-label="Visual experiments">
        {galleryPages.map((page, index) => (
          <a class="experiment" href={page.href} data-index={String(index + 1).padStart(2, '0')}>
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="title">{page.title}</span>
            <span class="category">{page.category}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>

      <footer>
        <span>VisualLab</span>
        <span>Visual studies for the web</span>
      </footer>
    </div>
  </main>

  <script>
    const home = document.querySelector<HTMLElement>('#homeStage');
    const links = [...document.querySelectorAll<HTMLElement>('.experiment')];
    const activeIndex = document.querySelector<HTMLElement>('#activeIndex');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const palettes = [
      ['#ff6a62', '#7764ff', '#58d9c2'],
      ['#745cff', '#59d8ff', '#ff8d5f'],
      ['#d6a85f', '#738e69', '#7e91a9']
    ];

    let targetX = .62;
    let targetY = .34;
    let currentX = targetX;
    let currentY = targetY;

    function applyMotion(x: number, y: number) {
      if (!home) return;
      const nx = (x - .5) * 2;
      const ny = (y - .5) * 2;
      home.style.setProperty('--pointer-x', `${x * 100}%`);
      home.style.setProperty('--pointer-y', `${y * 100}%`);
      home.style.setProperty('--v-x', `${nx * -42}px`);
      home.style.setProperty('--v-y', `${ny * -24}px`);
      home.style.setProperty('--l-x', `${nx * 54}px`);
      home.style.setProperty('--l-y', `${ny * 32}px`);
      home.style.setProperty('--dot-x', `${nx * -68}px`);
      home.style.setProperty('--dot-y', `${ny * 45}px`);
      home.style.setProperty('--grid-x', `${nx * 13}px`);
      home.style.setProperty('--grid-y', `${ny * 9}px`);
    }

    function updateScroll() {
      if (!home) return;
      const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      const progress = Math.min(1, Math.max(0, window.scrollY / max));
      home.style.setProperty('--scroll-shift', `${progress * 110}px`);
      home.style.setProperty('--scroll-rotate', `${-7 + progress * 14}deg`);
      home.style.setProperty('--scan-y', `${progress * 100}%`);
      home.style.setProperty('--headline-shift', `${progress * -34}px`);
    }

    function setPalette(index: number | null) {
      if (!home) return;
      if (index === null) {
        home.style.setProperty('--a', '#6b5cff');
        home.style.setProperty('--b', '#5dd8c6');
        home.style.setProperty('--c', '#ff7568');
        activeIndex!.textContent = '00';
        home.classList.remove('has-active');
        return;
      }
      const p = palettes[index] ?? palettes[0];
      home.style.setProperty('--a', p[0]);
      home.style.setProperty('--b', p[1]);
      home.style.setProperty('--c', p[2]);
      activeIndex!.textContent = links[index]?.dataset.index ?? '00';
      home.classList.add('has-active');
    }

    function animate() {
      currentX += (targetX - currentX) * .06;
      currentY += (targetY - currentY) * .06;
      applyMotion(currentX, currentY);
      requestAnimationFrame(animate);
    }

    window.addEventListener('pointermove', (event) => {
      targetX = event.clientX / Math.max(window.innerWidth, 1);
      targetY = event.clientY / Math.max(window.innerHeight, 1);
    }, { passive: true });
    window.addEventListener('pointerleave', () => { targetX = .62; targetY = .34; });
    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll, { passive: true });

    links.forEach((link, index) => {
      link.addEventListener('pointerenter', () => setPalette(index));
      link.addEventListener('focus', () => setPalette(index));
      link.addEventListener('pointerleave', () => setPalette(null));
      link.addEventListener('blur', () => setPalette(null));
    });

    setPalette(null);
    updateScroll();
    applyMotion(currentX, currentY);
    if (!reducedMotion) animate();
  </script>
</BaseLayout>

<style>
  :global(.home-page) { background: #f0eee8; color: #151515; }

  .home {
    --a: #6b5cff;
    --b: #5dd8c6;
    --c: #ff7568;
    --pointer-x: 62%;
    --pointer-y: 34%;
    --v-x: 0px;
    --v-y: 0px;
    --l-x: 0px;
    --l-y: 0px;
    --dot-x: 0px;
    --dot-y: 0px;
    --grid-x: 0px;
    --grid-y: 0px;
    --scroll-shift: 0px;
    --scroll-rotate: -7deg;
    --scan-y: 0%;
    --headline-shift: 0px;
    position: relative;
    min-height: 100vh;
    overflow: clip;
    background: #f0eee8;
    color: #151515;
    transition: background .45s ease, color .45s ease;
  }

  :global(html[data-theme='dark'] .home-page .home) { background: #090a0d; color: #f1f0eb; }
  .home-shell { position: relative; z-index: 4; min-height: 100vh; display: flex; flex-direction: column; }

  .ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }

  .wash {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: .3;
    transition: background 700ms ease, opacity 400ms ease, transform 500ms ease;
  }
  .wash-a {
    width: 50vw;
    height: 50vw;
    min-width: 520px;
    min-height: 520px;
    left: calc(var(--pointer-x) - 26vw);
    top: calc(var(--pointer-y) - 26vw);
    background: color-mix(in srgb, var(--a) 54%, transparent);
  }
  .wash-b {
    width: 42vw;
    height: 42vw;
    min-width: 420px;
    min-height: 420px;
    right: -11vw;
    bottom: calc(-18vw + var(--scroll-shift));
    background: color-mix(in srgb, var(--b) 42%, transparent);
  }
  .has-active .wash { opacity: .44; }
  :global(html[data-theme='dark'] .home-page .wash) { opacity: .18; filter: blur(90px); }
  :global(html[data-theme='dark'] .home-page .has-active .wash) { opacity: .28; }

  .grid-plane {
    position: absolute;
    width: 92vw;
    height: 78vh;
    left: 4vw;
    top: 12vh;
    opacity: .13;
    background-image:
      linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 54px 54px;
    transform: perspective(900px) rotateX(68deg) rotateZ(var(--scroll-rotate)) translate3d(var(--grid-x), calc(var(--grid-y) + var(--scroll-shift)), 0);
    transform-origin: center 70%;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 25%, #000 72%, transparent 100%);
    transition: color 500ms ease;
  }

  .type-field { position: absolute; inset: 0; }
  .type-field > span { position: absolute; display: block; line-height: .72; font-weight: 900; user-select: none; transition: color 600ms ease, opacity 350ms ease; }
  .type-v {
    left: -5vw;
    top: 13vh;
    font-size: clamp(15rem, 32vw, 34rem);
    color: color-mix(in srgb, var(--a) 68%, currentColor);
    opacity: .075;
    transform: translate3d(var(--v-x), calc(var(--v-y) - var(--scroll-shift)), 0) rotate(-9deg);
  }
  .type-l {
    right: -2vw;
    bottom: -2vh;
    font-size: clamp(14rem, 29vw, 31rem);
    color: color-mix(in srgb, var(--b) 72%, currentColor);
    opacity: .07;
    transform: translate3d(var(--l-x), calc(var(--l-y) + var(--scroll-shift)), 0) rotate(6deg);
  }
  .type-dot {
    right: 18vw;
    top: 9vh;
    font-size: clamp(5rem, 10vw, 10rem);
    color: var(--c);
    opacity: .16;
    transform: translate3d(var(--dot-x), var(--dot-y), 0);
  }
  .active-index {
    right: 4vw;
    top: 37vh;
    font-size: clamp(11rem, 25vw, 27rem);
    letter-spacing: -.1em;
    color: currentColor;
    opacity: 0 !important;
    transform: translateY(18px) rotate(-3deg);
    transition: opacity .3s ease, transform .45s cubic-bezier(.2,.8,.2,1), color .5s ease !important;
  }
  .has-active .active-index { opacity: .035 !important; transform: translateY(0) rotate(-3deg); }
  :global(html[data-theme='dark'] .home-page .has-active .active-index) { opacity: .06 !important; }

  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--scan-y);
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--a) 45%, transparent), transparent);
    opacity: .45;
    transition: background .5s ease;
  }

  .topbar { height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); }
  .brand { font-size: .94rem; font-weight: 800; letter-spacing: -.035em; }
  .count, footer { color: color-mix(in srgb, currentColor 50%, transparent); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }

  .intro {
    padding: clamp(78px, 11vw, 142px) 0 clamp(64px, 9vw, 108px);
    max-width: 880px;
    position: relative;
    transform: translateY(var(--headline-shift));
    transition: transform .1s linear;
  }
  .kicker { margin: 0 0 22px; color: color-mix(in srgb, currentColor 52%, transparent); font-size: .62rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(4.5rem, 10.5vw, 10rem); line-height: .72; letter-spacing: -.085em; font-weight: 770; }
  h1 i { font-family: Georgia, serif; font-weight: 400; color: var(--a); transition: color .55s ease; }
  .intro > p:last-child { max-width: 500px; margin: 38px 0 0; color: color-mix(in srgb, currentColor 52%, transparent); line-height: 1.8; }

  .experiments { border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent); position: relative; }
  .experiment {
    position: relative;
    min-height: 94px;
    display: grid;
    grid-template-columns: 64px 1fr auto 34px;
    gap: 20px;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    transition: padding .32s cubic-bezier(.2,.8,.2,1), background .3s ease;
  }
  .experiment::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: right;
    background: linear-gradient(90deg, color-mix(in srgb, var(--a) 12%, transparent), color-mix(in srgb, var(--b) 7%, transparent));
    transition: transform .42s cubic-bezier(.2,.8,.2,1);
    z-index: -1;
  }
  .experiment:hover, .experiment:focus-visible { padding: 0 18px; }
  .experiment:hover::before, .experiment:focus-visible::before { transform: scaleX(1); transform-origin: left; }
  .number, .category { color: color-mix(in srgb, currentColor 44%, transparent); font-size: .61rem; letter-spacing: .13em; text-transform: uppercase; }
  .title { font-size: clamp(1.4rem, 3vw, 2.05rem); font-weight: 620; letter-spacing: -.04em; transition: transform .32s ease, letter-spacing .32s ease; }
  .experiment:hover .title, .experiment:focus-visible .title { transform: translateX(8px); letter-spacing: -.015em; }
  .category { text-align: right; }
  .arrow { font-size: .95rem; transition: transform .3s ease; }
  .experiment:hover .arrow, .experiment:focus-visible .arrow { transform: translate(4px,-4px) rotate(5deg); }

  footer { margin-top: auto; min-height: 100px; display: flex; align-items: center; justify-content: space-between; }

  @media(max-width:640px){
    .experiment{grid-template-columns:44px 1fr 28px;gap:12px}.category{display:none}.intro>p:last-child{max-width:340px}
    .grid-plane{width:120vw;left:-10vw}.type-v{left:-16vw}.type-l{right:-12vw}.active-index{right:-4vw}
  }

  @media(prefers-reduced-motion:reduce){
    .grid-plane,.type-v,.type-l,.type-dot,.intro{transform:none}
    .scanline{display:none}
  }
</style>

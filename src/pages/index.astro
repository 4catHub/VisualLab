---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryPages } from '@/data/pages';
---
<BaseLayout title="VisualLab" description="A small collection of visual experiments, motion studies, and interactive scenes." className="home-page">
  <main class="home" id="homeStage">
    <div class="ambient" aria-hidden="true">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="lens" id="lens"><span>VISUAL</span></div>
      <div class="trace trace-a">V</div>
      <div class="trace trace-b">L</div>
      <div class="trace trace-c">●</div>
    </div>

    <div class="shell home-shell">
      <header class="topbar">
        <a class="brand" href="/">VisualLab</a>
        <span class="count">{String(galleryPages.length).padStart(2, '0')} experiments</span>
      </header>

      <section class="intro" aria-labelledby="page-title">
        <p class="kicker">A collection of visual experiments</p>
        <h1 id="page-title">Look.<br /><i>Move.</i><br />Stay.</h1>
        <p>색, 움직임, 공간, 계절과 작은 상호작용을 웹 위에서 실험합니다. 설명보다 장면을 먼저 보여주는 페이지들을 모읍니다.</p>
      </section>

      <nav class="experiments" aria-label="Visual experiments">
        {galleryPages.map((page, index) => (
          <a class="experiment" href={page.href} data-index={String(index + 1).padStart(2, '0')}>
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="title">{page.title}</span>
            <span class="category">{page.category}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>

      <footer>
        <span>VisualLab</span>
        <span>Visual studies for the web</span>
      </footer>
    </div>
  </main>

  <script>
    const home = document.querySelector<HTMLElement>('#homeStage');
    const lens = document.querySelector<HTMLElement>('#lens');
    const links = document.querySelectorAll<HTMLElement>('.experiment');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let tx = .72;
    let ty = .34;
    let x = tx;
    let y = ty;

    function setPointer(clientX: number, clientY: number) {
      tx = clientX / Math.max(window.innerWidth, 1);
      ty = clientY / Math.max(window.innerHeight, 1);
    }

    function animate() {
      x += (tx - x) * .055;
      y += (ty - y) * .055;
      home?.style.setProperty('--px', x.toFixed(4));
      home?.style.setProperty('--py', y.toFixed(4));
      requestAnimationFrame(animate);
    }

    window.addEventListener('pointermove', (event) => setPointer(event.clientX, event.clientY), { passive: true });
    window.addEventListener('pointerleave', () => { tx = .72; ty = .34; });

    links.forEach((link) => {
      link.addEventListener('pointerenter', () => {
        const index = link.dataset.index ?? '00';
        if (lens) lens.innerHTML = `<span>${index}</span>`;
        home?.classList.add('link-active');
      });
      link.addEventListener('pointerleave', () => {
        if (lens) lens.innerHTML = '<span>VISUAL</span>';
        home?.classList.remove('link-active');
      });
    });

    if (!reducedMotion) animate();
  </script>
</BaseLayout>

<style>
  :global(.home-page) { background: #f0eee8; color: #151515; }
  .home {
    --px: .72;
    --py: .34;
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #f0eee8;
    color: #151515;
    transition: background .45s ease, color .45s ease;
  }
  :global(html[data-theme='dark'] .home-page .home) { background: #090a0d; color: #f1f0eb; }
  .home-shell { position: relative; z-index: 4; min-height: 100vh; display: flex; flex-direction: column; }

  .ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(1px); mix-blend-mode: multiply; opacity: .62; }
  .orb-a {
    width: min(44vw, 650px); aspect-ratio: 1;
    left: calc(var(--px) * 100% - 22vw); top: calc(var(--py) * 100% - 22vw);
    background: radial-gradient(circle at 34% 30%, rgba(255,118,101,.62), rgba(111,91,255,.28) 46%, transparent 69%);
    transition: opacity .4s ease;
  }
  .orb-b {
    width: min(32vw, 470px); aspect-ratio: 1;
    right: calc((1 - var(--px)) * 18vw - 8vw); bottom: calc((1 - var(--py)) * 16vh - 6vh);
    background: radial-gradient(circle, rgba(83,220,203,.48), transparent 67%);
  }
  :global(html[data-theme='dark'] .home-page .orb) { mix-blend-mode: screen; opacity: .34; }

  .lens {
    position: absolute;
    width: clamp(120px, 17vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    left: calc(var(--px) * 100%);
    top: calc(var(--py) * 100%);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border: 1px solid rgba(21,21,21,.2);
    background: rgba(255,255,255,.13);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.15), 0 24px 70px rgba(54,44,94,.08);
    backdrop-filter: blur(10px) saturate(1.3);
    transition: width .35s ease, border-color .35s ease, background .35s ease;
  }
  .lens::before, .lens::after { content: ''; position: absolute; border-radius: 50%; border: 1px solid currentColor; opacity: .13; }
  .lens::before { inset: 17%; }
  .lens::after { inset: 34%; }
  .lens span { font-size: .58rem; font-weight: 800; letter-spacing: .24em; transform: translateX(.12em); }
  .link-active .lens { width: clamp(150px, 21vw, 320px); }
  .link-active .lens span { font-size: clamp(2.8rem, 6vw, 6.4rem); letter-spacing: -.08em; }
  :global(html[data-theme='dark'] .home-page .lens) { border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.035); }

  .trace { position: absolute; font-weight: 900; line-height: 1; opacity: .05; transform-origin: center; user-select: none; }
  .trace-a { font-size: 26vw; left: -5vw; top: 18vh; transform: translate3d(calc((var(--px) - .5) * -22px), calc((var(--py) - .5) * -14px),0) rotate(-12deg); }
  .trace-b { font-size: 22vw; right: -3vw; bottom: 4vh; transform: translate3d(calc((var(--px) - .5) * 28px), calc((var(--py) - .5) * 18px),0) rotate(9deg); }
  .trace-c { font-size: 12vw; right: 18vw; top: 12vh; color: #6b5cff; opacity: .1; transform: translate3d(calc((var(--px) - .5) * -32px), calc((var(--py) - .5) * 24px),0); }

  .topbar { height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 14%, transparent); }
  .brand { font-size: .94rem; font-weight: 800; letter-spacing: -.035em; }
  .count, footer { color: color-mix(in srgb, currentColor 50%, transparent); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
  .intro { padding: clamp(78px, 11vw, 142px) 0 clamp(64px, 9vw, 108px); max-width: 880px; position: relative; }
  .kicker { margin: 0 0 22px; color: color-mix(in srgb, currentColor 52%, transparent); font-size: .62rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(4.5rem, 10.5vw, 10rem); line-height: .72; letter-spacing: -.085em; font-weight: 770; }
  h1 i { font-family: Georgia, serif; font-weight: 400; color: #6b5cff; }
  :global(html[data-theme='dark'] .home-page h1 i) { color: #a89cff; }
  .intro > p:last-child { max-width: 500px; margin: 38px 0 0; color: color-mix(in srgb, currentColor 52%, transparent); line-height: 1.8; }
  .experiments { border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent); position: relative; }
  .experiment { min-height: 94px; display: grid; grid-template-columns: 64px 1fr auto 34px; gap: 20px; align-items: center; border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); transition: padding .25s ease, background .25s ease, letter-spacing .25s ease; }
  .experiment:hover { padding: 0 16px; background: color-mix(in srgb, currentColor 4%, transparent); }
  .number, .category { color: color-mix(in srgb, currentColor 44%, transparent); font-size: .61rem; letter-spacing: .13em; text-transform: uppercase; }
  .title { font-size: clamp(1.4rem, 3vw, 2.05rem); font-weight: 620; letter-spacing: -.04em; transition: letter-spacing .25s ease; }
  .experiment:hover .title { letter-spacing: -.015em; }
  .category { text-align: right; }
  .arrow { font-size: .95rem; transition: transform .25s ease; }
  .experiment:hover .arrow { transform: translate(3px,-3px); }
  footer { margin-top: auto; min-height: 100px; display: flex; align-items: center; justify-content: space-between; }

  @media(max-width:640px){
    .experiment{grid-template-columns:44px 1fr 28px;gap:12px}.category{display:none}.intro>p:last-child{max-width:340px}
    .lens { width: 120px; opacity: .72; }
    .orb-a { width: 70vw; left: calc(var(--px) * 100% - 35vw); top: calc(var(--py) * 100% - 35vw); }
  }

  @media(prefers-reduced-motion:reduce){
    .lens{left:76%;top:33%}.orb-a{left:52%;top:10%}.orb-b{right:-8%;bottom:5%}
  }
</style>

  h1 em { color:transparent; -webkit-text-stroke:1px rgba(195,224,255,.72); font-family:Georgia,serif; font-weight:400; }
  .intro>p:not(.eyebrow) { position:relative; width:min(560px,92%); margin:28px auto 0; color:#8b9bb5; font-size:.83rem; line-height:1.8; }

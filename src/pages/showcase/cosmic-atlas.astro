---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cosmic Atlas — VisualLab"
  description="A pan-and-zoom cosmic atlas that moves from constellations and nebulae to galaxies and galaxy clusters."
  className="cosmic-atlas-page"
>
  <main class="atlas" id="atlasStage">
    <canvas class="space" id="spaceCanvas" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <header class="topbar">
      <a href="/" class="brand">← VisualLab</a>
      <div class="title-lockup">
        <span>COSMIC ATLAS</span>
        <i>44 OBJECTS / RELATIVE MAP / NOT TO PHYSICAL SCALE</i>
      </div>
      <button class="reset" id="resetButton" type="button">HOME VIEW</button>
    </header>

    <aside class="scale-rail" aria-label="Cosmic scale">
      <span class="rail-caption">SCALE</span>
      <div class="rail-line"><i id="scaleMarker"></i></div>
      <button type="button" data-level="4">CONSTELLATION</button>
      <button type="button" data-level="3">NEBULA / CLUSTER</button>
      <button type="button" data-level="2">GALAXY</button>
      <button type="button" data-level="1">GALAXY GROUP</button>
      <button type="button" data-level="0">GALAXY CLUSTER</button>
    </aside>

    <section class="hud" aria-label="Atlas status">
      <div class="hud-block"><span>VIEW</span><strong id="levelLabel">GALAXY</strong></div>
      <div class="hud-block coordinates"><span>FIELD POSITION</span><strong id="positionLabel">+000 / +000</strong></div>
      <div class="hud-block"><span>MAGNIFICATION</span><strong id="zoomLabel">1.00×</strong></div>
      <div class="hud-block catalog"><span>VISIBLE OBJECTS</span><strong id="visibleLabel">00 / 44</strong></div>
    </section>

    <section class="intro" id="introPanel">
      <p class="eyebrow">Pan / zoom / inspect</p>
      <h1>THE SKY<br />DOESN'T END<br /><em>AT THE SKY.</em></h1>
      <p>드래그해서 공간을 옮기고, 휠이나 핀치로 확대·축소하세요. 별자리에서 성운과 성단, 은하와 은하군, 은하단까지 같은 지도 안에서 밀도가 달라집니다. 이름이 보이는 천체는 직접 선택해 더 자세히 볼 수 있습니다.</p>
      <button id="enterAtlas" type="button">ENTER THE MAP <span>↘</span></button>
    </section>

    <aside class="object-panel" id="objectPanel" aria-live="polite">
      <button class="panel-close" id="panelClose" type="button" aria-label="Close object details">×</button>
      <span class="object-kind" id="objectKind">GALAXY</span>
      <h2 id="objectName">Andromeda</h2>
      <p class="object-distance" id="objectDistance">~2.5 million light-years</p>
      <p class="object-copy" id="objectCopy">Local Group의 대표적인 나선은하. 맨눈으로도 어두운 하늘에서 희미하게 볼 수 있습니다.</p>
      <dl>
        <div><dt>MAP</dt><dd id="objectMap">+490 / −190</dd></div>
        <div><dt>ZOOM BAND</dt><dd id="objectBand">GALAXY</dd></div>
      </dl>
    </aside>

    <div class="zoom-controls" aria-label="Zoom controls">
      <button id="zoomIn" type="button" aria-label="Zoom in">+</button>
      <button id="zoomOut" type="button" aria-label="Zoom out">−</button>
    </div>

    <div class="mini-map-wrap" aria-label="Overview map">
      <div class="mini-head"><span>OVERVIEW</span><i id="miniScale">GALAXY</i></div>
      <canvas id="miniMap" width="220" height="128" aria-hidden="true"></canvas>
    </div>

    <div class="interaction-note" id="interactionNote">
      <span class="mouse-icon" aria-hidden="true"><i></i></span>
      <span>DRAG TO PAN<br />SCROLL TO CHANGE SCALE</span>
    </div>

    <div class="cursor-label" id="cursorLabel" aria-hidden="true"></div>
  </main>

  <script>
    type AtlasObject = {
      id: string;
      name: string;
      type: 'constellation' | 'nebula' | 'cluster' | 'galaxy' | 'group' | 'galaxy-cluster';
      x: number;
      y: number;
      size: number;
      minZoom: number;
      maxZoom: number;
      accent: string;
      distance: string;
      band: string;
      copy: string;
      seed: number;
    };
    type Point = { x: number; y: number };

    const canvas = document.querySelector<HTMLCanvasElement>('#spaceCanvas');
    const ctx = canvas?.getContext('2d');
    const miniMap = document.querySelector<HTMLCanvasElement>('#miniMap');
    const miniCtx = miniMap?.getContext('2d');
    const stage = document.querySelector<HTMLElement>('#atlasStage');
    const intro = document.querySelector<HTMLElement>('#introPanel');
    const enterButton = document.querySelector<HTMLButtonElement>('#enterAtlas');
    const resetButton = document.querySelector<HTMLButtonElement>('#resetButton');
    const zoomInButton = document.querySelector<HTMLButtonElement>('#zoomIn');
    const zoomOutButton = document.querySelector<HTMLButtonElement>('#zoomOut');
    const levelButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-level]')];
    const levelLabel = document.querySelector<HTMLElement>('#levelLabel');
    const positionLabel = document.querySelector<HTMLElement>('#positionLabel');
    const zoomLabel = document.querySelector<HTMLElement>('#zoomLabel');
    const visibleLabel = document.querySelector<HTMLElement>('#visibleLabel');
    const scaleMarker = document.querySelector<HTMLElement>('#scaleMarker');
    const miniScale = document.querySelector<HTMLElement>('#miniScale');
    const note = document.querySelector<HTMLElement>('#interactionNote');
    const cursorLabel = document.querySelector<HTMLElement>('#cursorLabel');
    const objectPanel = document.querySelector<HTMLElement>('#objectPanel');
    const panelClose = document.querySelector<HTMLButtonElement>('#panelClose');
    const objectKind = document.querySelector<HTMLElement>('#objectKind');
    const objectName = document.querySelector<HTMLElement>('#objectName');
    const objectDistance = document.querySelector<HTMLElement>('#objectDistance');
    const objectCopy = document.querySelector<HTMLElement>('#objectCopy');
    const objectMap = document.querySelector<HTMLElement>('#objectMap');
    const objectBand = document.querySelector<HTMLElement>('#objectBand');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const objects: AtlasObject[] = [
      { id:'orion', name:'Orion', type:'constellation', x:-310, y:140, size:115, minZoom:2.7, maxZoom:7.5, accent:'#b8e8ff', distance:'~1,300 light-years across this view', band:'CONSTELLATION', copy:'오리온의 밝은 별들과 허리띠를 하나의 선형 패턴으로 읽는 영역입니다. 내부에 오리온 성운이 겹쳐 보입니다.', seed:11 },
      { id:'cassiopeia', name:'Cassiopeia', type:'constellation', x:260, y:-250, size:104, minZoom:2.9, maxZoom:7.5, accent:'#e7d7ff', distance:'~440–550 light-years to key stars', band:'CONSTELLATION', copy:'W 모양으로 읽히는 북쪽 하늘의 별자리. 확대하면 밝기가 다른 다섯 개의 주성이 연결됩니다.', seed:19 },
      { id:'cygnus', name:'Cygnus', type:'constellation', x:470, y:210, size:130, minZoom:3.1, maxZoom:7.5, accent:'#b9dcff', distance:'~1,400–2,600 light-years to key stars', band:'CONSTELLATION', copy:'은하수의 짙은 별밭을 가로지르는 백조자리. 십자 형태의 주요 별을 중심으로 구성했습니다.', seed:23 },
      { id:'ursa-major', name:'Ursa Major', type:'constellation', x:-120, y:-470, size:140, minZoom:2.8, maxZoom:7.5, accent:'#c7e5ff', distance:'~80–120 light-years to several bright stars', band:'CONSTELLATION', copy:'북두칠성으로 익숙한 큰곰자리 영역. 손잡이와 국자 형태가 긴 선으로 이어져 지도 북쪽을 채웁니다.', seed:27 },
      { id:'scorpius', name:'Scorpius', type:'constellation', x:610, y:120, size:138, minZoom:2.9, maxZoom:7.5, accent:'#ffd0bb', distance:'Hundreds of light-years to key stars', band:'CONSTELLATION', copy:'붉은 안타레스를 중심으로 굽은 꼬리가 이어지는 별자리. 남쪽 방향의 넓은 곡선 패턴으로 표현했습니다.', seed:29 },
      { id:'sagittarius', name:'Sagittarius', type:'constellation', x:50, y:360, size:145, minZoom:2.7, maxZoom:7.5, accent:'#ffe4b8', distance:'Toward the Milky Way core', band:'CONSTELLATION', copy:'은하 중심 방향을 향하는 별자리. 주변에 라군 성운과 독수리 성운 같은 깊은 하늘 천체가 몰려 있습니다.', seed:33 },
      { id:'lyra', name:'Lyra', type:'constellation', x:560, y:-80, size:84, minZoom:3.0, maxZoom:7.5, accent:'#c9d9ff', distance:'~25 light-years to Vega', band:'CONSTELLATION', copy:'베가를 중심으로 작은 평행사변형이 붙는 거문고자리. 내부에 고리 성운이 자리합니다.', seed:35 },
      { id:'taurus', name:'Taurus', type:'constellation', x:-130, y:-255, size:118, minZoom:2.8, maxZoom:7.5, accent:'#d6e6ff', distance:'~150 light-years to Hyades', band:'CONSTELLATION', copy:'황소의 얼굴을 이루는 V자 별무리와 플레이아데스 방향을 함께 읽을 수 있는 영역입니다.', seed:39 },

      { id:'orion-nebula', name:'Orion Nebula · M42', type:'nebula', x:-276, y:164, size:62, minZoom:1.75, maxZoom:5.8, accent:'#d6a8ff', distance:'~1,344 light-years', band:'NEBULA', copy:'오리온자리 검 아래에 놓인 거대한 별 탄생 영역. 지도에서는 보랏빛 가스 구름으로 표시됩니다.', seed:41 },
      { id:'rosette', name:'Rosette Nebula', type:'nebula', x:-520, y:-40, size:86, minZoom:1.55, maxZoom:4.7, accent:'#ff98b7', distance:'~5,200 light-years', band:'NEBULA', copy:'외뿔소자리 방향에 있는 큰 방출성운. 중심 성단의 복사와 항성풍이 주변 가스를 밀어낸 구조를 가집니다.', seed:43 },
      { id:'eagle', name:'Eagle Nebula · M16', type:'nebula', x:82, y:322, size:72, minZoom:1.6, maxZoom:4.7, accent:'#ffc0a0', distance:'~7,000 light-years', band:'NEBULA', copy:'독수리 성운은 젊은 별들과 짙은 먼지 기둥이 공존하는 별 탄생 영역입니다.', seed:47 },
      { id:'lagoon', name:'Lagoon Nebula · M8', type:'nebula', x:22, y:405, size:78, minZoom:1.55, maxZoom:4.6, accent:'#ff91bd', distance:'~4,000–5,000 light-years', band:'NEBULA', copy:'궁수자리 방향의 밝은 방출성운. 은하 중심 쪽을 탐색할 때 독수리 성운과 함께 이어서 볼 수 있습니다.', seed:49 },
      { id:'carina', name:'Carina Nebula', type:'nebula', x:-430, y:490, size:112, minZoom:1.45, maxZoom:4.4, accent:'#f49dff', distance:'~7,500 light-years', band:'NEBULA', copy:'매우 밝고 거대한 별 형성 영역. 지도 남서쪽의 넓은 가스 구름으로 배치했습니다.', seed:51 },
      { id:'crab', name:'Crab Nebula · M1', type:'nebula', x:-92, y:-214, size:44, minZoom:1.9, maxZoom:5.2, accent:'#9ddfff', distance:'~6,500 light-years', band:'SUPERNOVA REMNANT', copy:'1054년에 관측된 초신성 폭발의 잔해로 알려진 성운. 작지만 밝은 파편 구조로 나타납니다.', seed:53 },
      { id:'north-america', name:'North America Nebula', type:'nebula', x:520, y:165, size:88, minZoom:1.6, maxZoom:4.7, accent:'#ff9ea8', distance:'~2,000 light-years', band:'NEBULA', copy:'백조자리 데네브 근처의 거대한 방출성운. 넓은 면적 때문에 확대 단계에서 흐린 윤곽으로 먼저 드러납니다.', seed:57 },
      { id:'ring-nebula', name:'Ring Nebula · M57', type:'nebula', x:584, y:-54, size:35, minZoom:2.0, maxZoom:5.8, accent:'#91d9ff', distance:'~2,300 light-years', band:'PLANETARY NEBULA', copy:'거문고자리의 대표적인 행성상성운. 작고 또렷한 고리 형태의 빛으로 표시됩니다.', seed:59 },

      { id:'pleiades', name:'Pleiades · M45', type:'cluster', x:-40, y:-300, size:42, minZoom:1.8, maxZoom:5.4, accent:'#95c9ff', distance:'~444 light-years', band:'OPEN CLUSTER', copy:'황소자리 방향의 산개성단. 푸른 별들이 느슨하게 모인 형태로 확대 레벨에서 또렷해집니다.', seed:61 },
      { id:'hyades', name:'Hyades', type:'cluster', x:-128, y:-248, size:48, minZoom:1.85, maxZoom:5.4, accent:'#ffd4a7', distance:'~153 light-years', band:'OPEN CLUSTER', copy:'태양계에서 가까운 산개성단 중 하나. 황소자리의 V자 얼굴을 구성하는 별무리입니다.', seed:63 },
      { id:'omega-centauri', name:'Omega Centauri', type:'cluster', x:210, y:430, size:52, minZoom:1.75, maxZoom:5.0, accent:'#ffdca8', distance:'~17,000 light-years', band:'GLOBULAR CLUSTER', copy:'우리 은하에서 가장 크고 밝은 구상성단 중 하나. 밀도가 높은 구형 별무리로 표현했습니다.', seed:67 },
      { id:'m13', name:'Hercules Cluster · M13', type:'cluster', x:380, y:-390, size:46, minZoom:1.85, maxZoom:5.0, accent:'#ffe2bb', distance:'~22,000 light-years', band:'GLOBULAR CLUSTER', copy:'헤르쿨레스자리 방향의 밝은 구상성단. 중심으로 갈수록 별의 밀도가 급격히 높아지는 구조입니다.', seed:69 },
      { id:'double-cluster', name:'Double Cluster', type:'cluster', x:326, y:-306, size:56, minZoom:1.75, maxZoom:4.9, accent:'#add7ff', distance:'~7,500 light-years', band:'OPEN CLUSTERS', copy:'페르세우스자리 방향에서 두 개의 산개성단이 나란히 보이는 대상. 두 개의 작은 별무리로 묶어 표현했습니다.', seed:71 },
      { id:'beehive', name:'Beehive Cluster · M44', type:'cluster', x:-510, y:250, size:54, minZoom:1.75, maxZoom:4.8, accent:'#fff0bb', distance:'~610 light-years', band:'OPEN CLUSTER', copy:'게자리 방향의 넓은 산개성단. 밝은 별이 한 점에 몰리지 않고 넓게 흩어진 형태입니다.', seed:73 },

      { id:'milky-way', name:'Milky Way', type:'galaxy', x:0, y:0, size:310, minZoom:.6, maxZoom:2.65, accent:'#b6d8ff', distance:'You are here', band:'GALAXY', copy:'우리가 속한 막대나선은하. 이 지도에서 다음 스케일로 넘어가는 기준점이자 중심 좌표입니다.', seed:79 },
      { id:'andromeda', name:'Andromeda · M31', type:'galaxy', x:490, y:-190, size:205, minZoom:.46, maxZoom:1.78, accent:'#bdd8ff', distance:'~2.5 million light-years', band:'GALAXY', copy:'Local Group의 가장 큰 은하. 우리 은하와 같은 그룹 안에 있으며 화면 북동쪽 방향에 배치했습니다.', seed:83 },
      { id:'triangulum', name:'Triangulum · M33', type:'galaxy', x:350, y:270, size:116, minZoom:.5, maxZoom:1.72, accent:'#c7c0ff', distance:'~2.7 million light-years', band:'GALAXY', copy:'Local Group의 세 번째로 큰 나선은하. 안드로메다보다 작고 느슨한 팔 구조를 가집니다.', seed:89 },
      { id:'large-magellanic', name:'Large Magellanic Cloud', type:'galaxy', x:-330, y:390, size:92, minZoom:.66, maxZoom:2.1, accent:'#a6dfff', distance:'~163,000 light-years', band:'SATELLITE GALAXY', copy:'우리 은하 주변을 도는 위성은하. 남쪽 하늘 방향의 불규칙한 빛 덩어리로 나타냅니다.', seed:97 },
      { id:'small-magellanic', name:'Small Magellanic Cloud', type:'galaxy', x:-430, y:340, size:66, minZoom:.68, maxZoom:2.0, accent:'#b4cfff', distance:'~200,000 light-years', band:'SATELLITE GALAXY', copy:'대마젤란은하와 함께 남쪽 하늘에서 눈에 띄는 우리 은하의 위성은하입니다.', seed:101 },
      { id:'m81', name:'Bode’s Galaxy · M81', type:'galaxy', x:690, y:-105, size:122, minZoom:.42, maxZoom:1.5, accent:'#d3ddff', distance:'~12 million light-years', band:'GALAXY', copy:'M81 Group의 중심을 이루는 큰 나선은하. 바로 옆의 M82와 한 쌍처럼 탐색할 수 있습니다.', seed:103 },
      { id:'m82', name:'Cigar Galaxy · M82', type:'galaxy', x:752, y:-128, size:72, minZoom:.46, maxZoom:1.5, accent:'#ffc19f', distance:'~12 million light-years', band:'STARBURST GALAXY', copy:'활발한 별 형성으로 유명한 길쭉한 은하. M81과 가까운 위치에 배치했습니다.', seed:107 },
      { id:'m87', name:'Messier 87', type:'galaxy', x:-590, y:-330, size:112, minZoom:.36, maxZoom:1.2, accent:'#ffe2b4', distance:'~54 million light-years', band:'ELLIPTICAL GALAXY', copy:'Virgo Cluster 중심부의 거대 타원은하. 은하단 레벨과 은하 레벨을 연결하는 기준점 역할을 합니다.', seed:109 },
      { id:'sombrero', name:'Sombrero Galaxy · M104', type:'galaxy', x:-650, y:150, size:108, minZoom:.4, maxZoom:1.45, accent:'#ffe0b7', distance:'~30 million light-years', band:'GALAXY', copy:'밝은 중심부와 짙은 먼지 띠가 대비되는 은하. 지도 서쪽의 독립적인 탐색 지점으로 배치했습니다.', seed:113 },
      { id:'whirlpool', name:'Whirlpool Galaxy · M51', type:'galaxy', x:650, y:-385, size:102, minZoom:.38, maxZoom:1.38, accent:'#c9d5ff', distance:'~23 million light-years', band:'INTERACTING GALAXY', copy:'작은 동반은하와 상호작용하는 대표적인 나선은하. 바깥쪽 팔의 형태가 강조됩니다.', seed:127 },
      { id:'centaurus-a', name:'Centaurus A', type:'galaxy', x:-570, y:450, size:124, minZoom:.36, maxZoom:1.3, accent:'#ffcaad', distance:'~12 million light-years', band:'ACTIVE GALAXY', copy:'짙은 먼지 띠와 활동성 핵으로 유명한 가까운 은하. 남서쪽 은하군의 중심 표식입니다.', seed:131 },

      { id:'local-group', name:'Local Group', type:'group', x:110, y:45, size:610, minZoom:.27, maxZoom:.82, accent:'#9bbcff', distance:'~10 million light-years span', band:'GALAXY GROUP', copy:'우리 은하, 안드로메다, 삼각형자리 은하와 여러 작은 은하가 함께 속한 중력적 그룹입니다.', seed:137 },
      { id:'m81-group', name:'M81 Group', type:'group', x:720, y:-118, size:280, minZoom:.24, maxZoom:.64, accent:'#a9c9ff', distance:'~12 million light-years away', band:'GALAXY GROUP', copy:'M81과 M82를 포함하는 가까운 은하군. 오른쪽으로 이동하면 두 은하가 같은 영역에서 확대됩니다.', seed:139 },
      { id:'centaurus-group', name:'Centaurus A / M83 Group', type:'group', x:-560, y:430, size:320, minZoom:.23, maxZoom:.62, accent:'#ffc8aa', distance:'~11–15 million light-years away', band:'GALAXY GROUP', copy:'Centaurus A와 M83 주변에 분포하는 가까운 은하군 복합 영역입니다.', seed:149 },
      { id:'m101-group', name:'M101 Group', type:'group', x:660, y:-420, size:300, minZoom:.22, maxZoom:.6, accent:'#c6d4ff', distance:'~20–25 million light-years away', band:'GALAXY GROUP', copy:'M101 주변의 은하군을 나타낸 영역. Whirlpool Galaxy 방향과 함께 북동쪽 외곽 탐색을 채웁니다.', seed:151 },

      { id:'virgo', name:'Virgo Cluster', type:'galaxy-cluster', x:-620, y:-350, size:265, minZoom:.16, maxZoom:.58, accent:'#ffd39c', distance:'~54 million light-years', band:'GALAXY CLUSTER', copy:'수천 개에 가까운 은하가 모이는 가까운 대형 은하단. M87이 중심부의 대표적인 표식입니다.', seed:157 },
      { id:'fornax', name:'Fornax Cluster', type:'galaxy-cluster', x:620, y:430, size:220, minZoom:.16, maxZoom:.5, accent:'#ffc5ae', distance:'~62 million light-years', band:'GALAXY CLUSTER', copy:'남쪽 하늘 방향의 비교적 가까운 은하단. 여러 밝은 은하가 조밀하게 모여 있습니다.', seed:163 },
      { id:'coma', name:'Coma Cluster', type:'galaxy-cluster', x:720, y:-520, size:285, minZoom:.13, maxZoom:.46, accent:'#e9c1ff', distance:'~320 million light-years', band:'GALAXY CLUSTER', copy:'수천 개의 은하가 밀집한 거대 은하단. 가장 멀리 축소했을 때 북동쪽 외곽 구조로 나타납니다.', seed:167 },
      { id:'perseus', name:'Perseus Cluster', type:'galaxy-cluster', x:-760, y:520, size:250, minZoom:.13, maxZoom:.45, accent:'#a8d5ff', distance:'~240 million light-years', band:'GALAXY CLUSTER', copy:'페르세우스자리 방향의 풍부한 은하단. 서남쪽 외곽에서 큰 타원 형태의 밀집 구조로 보입니다.', seed:173 },
      { id:'hydra', name:'Hydra Cluster', type:'galaxy-cluster', x:-820, y:-40, size:230, minZoom:.13, maxZoom:.44, accent:'#b9dfff', distance:'~190 million light-years', band:'GALAXY CLUSTER', copy:'바다뱀자리 방향의 은하단. Virgo보다 훨씬 먼 외곽 구조를 비교할 수 있도록 서쪽에 배치했습니다.', seed:179 },
      { id:'norma', name:'Norma Cluster', type:'galaxy-cluster', x:-80, y:650, size:255, minZoom:.13, maxZoom:.43, accent:'#ffd0ad', distance:'~220 million light-years', band:'GALAXY CLUSTER', copy:'은하수의 별과 먼지 뒤쪽 방향에 놓이는 대형 은하단. 지도 남쪽 끝의 밀집 구조입니다.', seed:181 },
      { id:'centaurus-cluster', name:'Centaurus Cluster', type:'galaxy-cluster', x:-650, y:360, size:225, minZoom:.14, maxZoom:.46, accent:'#ffe0b7', distance:'~170 million light-years', band:'GALAXY CLUSTER', copy:'센타우루스자리 방향의 은하단. 가까운 Centaurus A 은하군보다 훨씬 먼 배경 층으로 나타납니다.', seed:191 }
    ];

    const constellationLines: Record<string, Point[]> = {
      orion:[{x:-355,y:105},{x:-330,y:140},{x:-300,y:126},{x:-272,y:148},{x:-250,y:104},{x:-300,y:126},{x:-286,y:172},{x:-263,y:205},{x:-286,y:172},{x:-330,y:140},{x:-340,y:205}],
      cassiopeia:[{x:210,y:-270},{x:242,y:-224},{x:276,y:-270},{x:316,y:-228},{x:350,y:-274}],
      cygnus:[{x:410,y:180},{x:456,y:205},{x:510,y:215},{x:558,y:235},{x:510,y:215},{x:498,y:165},{x:522,y:276}],
      'ursa-major':[{x:-188,y:-500},{x:-150,y:-478},{x:-110,y:-490},{x:-74,y:-470},{x:-42,y:-447},{x:-9,y:-430},{x:25,y:-438}],
      scorpius:[{x:548,y:66},{x:580,y:92},{x:610,y:120},{x:640,y:142},{x:670,y:168},{x:652,y:203},{x:628,y:226},{x:602,y:218}],
      sagittarius:[{x:-15,y:330},{x:24,y:350},{x:58,y:330},{x:84,y:365},{x:45,y:390},{x:4,y:377},{x:24,y:350},{x:45,y:390}],
      lyra:[{x:530,y:-112},{x:554,y:-78},{x:584,y:-96},{x:603,y:-62},{x:568,y:-42},{x:554,y:-78}],
      taurus:[{x:-188,y:-280},{x:-150,y:-245},{x:-110,y:-260},{x:-76,y:-226},{x:-110,y:-260},{x:-90,y:-310}]
    };

    const state = {
      width:window.innerWidth, height:window.innerHeight, dpr:Math.min(window.devicePixelRatio||1,2),
      cameraX:20, cameraY:10, targetCameraX:20, targetCameraY:10, zoom:.95, targetZoom:.95,
      dragging:false, dragStartX:0, dragStartY:0, cameraStartX:0, cameraStartY:0,
      hoverId:'', selectedId:'', time:0, pointers:new Map<number,Point>(), pinchDistance:0, pinchZoom:.95
    };

    const levels = [
      {label:'GALAXY CLUSTER',zoom:.21}, {label:'GALAXY GROUP',zoom:.42}, {label:'GALAXY',zoom:.95},
      {label:'NEBULA / CLUSTER',zoom:2.0}, {label:'CONSTELLATION',zoom:3.75}
    ];

    const clamp=(v:number,min:number,max:number)=>Math.min(max,Math.max(min,v));
    const lerp=(a:number,b:number,t:number)=>a+(b-a)*t;
    const seeded=(seed:number)=>{const x=Math.sin(seed*999.71)*43758.5453;return x-Math.floor(x)};
    const worldToScreen=(x:number,y:number):Point=>({x:state.width*.5+(x-state.cameraX)*state.zoom,y:state.height*.5+(y-state.cameraY)*state.zoom});
    const screenToWorld=(x:number,y:number):Point=>({x:state.cameraX+(x-state.width*.5)/state.zoom,y:state.cameraY+(y-state.height*.5)/state.zoom});

    function resize(){if(!canvas||!ctx)return;state.width=window.innerWidth;state.height=window.innerHeight;canvas.width=Math.floor(state.width*state.dpr);canvas.height=Math.floor(state.height*state.dpr);canvas.style.width=`${state.width}px`;canvas.style.height=`${state.height}px`;ctx.setTransform(state.dpr,0,0,state.dpr,0,0);drawMiniMap()}
    function objectOpacity(o:AtlasObject){const enter=clamp((state.zoom-o.minZoom)/Math.max(o.minZoom*.35,.07),0,1);const leave=clamp((o.maxZoom-state.zoom)/Math.max(o.maxZoom*.25,.1),0,1);return Math.min(enter,leave)}

    function drawBackgroundStars(){if(!ctx)return;const cell=state.zoom>1.8?88:state.zoom>.7?130:190;const l=state.cameraX-state.width/state.zoom/2-cell,t=state.cameraY-state.height/state.zoom/2-cell,r=state.cameraX+state.width/state.zoom/2+cell,b=state.cameraY+state.height/state.zoom/2+cell;for(let gy=Math.floor(t/cell);gy<=Math.ceil(b/cell);gy++){for(let gx=Math.floor(l/cell);gx<=Math.ceil(r/cell);gx++){const seed=gx*92821+gy*68917,count=state.zoom>2.2?7:state.zoom>.7?4:2;for(let i=0;i<count;i++){const p=worldToScreen((gx+seeded(seed+i*17))*cell,(gy+seeded(seed+i*29+3))*cell);const tw=.55+Math.sin(state.time*.001+seed+i)*.16,rr=.35+seeded(seed+i*7)*(state.zoom>2?1.25:.75);ctx.beginPath();ctx.fillStyle=`rgba(210,230,255,${(.16+seeded(seed+i*5)*.4)*tw})`;ctx.arc(p.x,p.y,rr,0,Math.PI*2);ctx.fill()}}}}
    function drawDust(){if(!ctx||state.zoom<.48||state.zoom>3.2)return;const c=worldToScreen(0,0);ctx.save();ctx.translate(c.x,c.y);ctx.rotate(-.28);const w=900*state.zoom,h=170*state.zoom,g=ctx.createRadialGradient(0,0,4,0,0,w*.65);g.addColorStop(0,`rgba(111,151,255,${.08*clamp(state.zoom,0,1.8)})`);g.addColorStop(.45,`rgba(110,87,173,${.045*clamp(state.zoom,0,1.4)})`);g.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=g;ctx.scale(1,h/Math.max(w,1));ctx.beginPath();ctx.arc(0,0,w,0,Math.PI*2);ctx.fill();ctx.restore()}
    function drawGalaxy(o:AtlasObject,a:number){if(!ctx)return;const p=worldToScreen(o.x,o.y),r=o.size*state.zoom*.36;if(r<2||p.x<-r*2||p.y<-r*2||p.x>state.width+r*2||p.y>state.height+r*2)return;ctx.save();ctx.translate(p.x,p.y);ctx.rotate((o.seed%9)*.17-.6);ctx.globalCompositeOperation='screen';const g=ctx.createRadialGradient(0,0,1,0,0,r);g.addColorStop(0,`rgba(245,248,255,${.8*a})`);g.addColorStop(.08,`rgba(184,208,255,${.42*a})`);g.addColorStop(.42,`rgba(115,133,205,${.14*a})`);g.addColorStop(1,'rgba(50,70,130,0)');const squash=.38+seeded(o.seed)*.22;ctx.scale(1,squash);ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.scale(1,1/squash);for(let arm=0;arm<3;arm++){ctx.beginPath();for(let i=0;i<64;i++){const tt=i/63,ang=arm*Math.PI*2/3+tt*5.6,rr=5+tt*r*.86,x=Math.cos(ang)*rr,y=Math.sin(ang)*rr*.42;i===0?ctx.moveTo(x,y):ctx.lineTo(x,y)}ctx.strokeStyle=`rgba(174,199,255,${.16*a})`;ctx.lineWidth=Math.max(.5,r*.012);ctx.stroke()}ctx.restore()}
    function drawNebula(o:AtlasObject,a:number){if(!ctx)return;const p=worldToScreen(o.x,o.y),r=o.size*state.zoom;if(r<3)return;ctx.save();ctx.globalCompositeOperation='screen';for(let i=0;i<9;i++){const ang=seeded(o.seed+i*7)*Math.PI*2,d=seeded(o.seed+i*11)*r*.44,x=p.x+Math.cos(ang)*d,y=p.y+Math.sin(ang)*d*.65,rr=r*(.22+seeded(o.seed+i*13)*.48),g=ctx.createRadialGradient(x,y,0,x,y,rr),alpha=(.04+seeded(o.seed+i*5)*.08)*a;g.addColorStop(0,`rgba(189,128,255,${alpha*2.5})`);g.addColorStop(.48,`rgba(255,120,170,${alpha})`);g.addColorStop(1,'rgba(90,120,255,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,rr,0,Math.PI*2);ctx.fill()}ctx.restore()}
    function drawStarCluster(o:AtlasObject,a:number){if(!ctx)return;const p=worldToScreen(o.x,o.y),r=o.size*state.zoom*.72;for(let i=0;i<42;i++){const ang=seeded(o.seed+i*17)*Math.PI*2,d=Math.pow(seeded(o.seed+i*23),.62)*r,x=p.x+Math.cos(ang)*d,y=p.y+Math.sin(ang)*d,s=.55+seeded(o.seed+i*31)*1.9;ctx.beginPath();ctx.fillStyle=`rgba(220,235,255,${(.22+seeded(o.seed+i)*.68)*a})`;ctx.arc(x,y,s,0,Math.PI*2);ctx.fill()}}
    function drawGalaxyCluster(o:AtlasObject,a:number){if(!ctx)return;const p=worldToScreen(o.x,o.y),r=o.size*state.zoom*.72;for(let i=0;i<58;i++){const ang=seeded(o.seed+i*13)*Math.PI*2,d=Math.pow(seeded(o.seed+i*19),.7)*r,x=p.x+Math.cos(ang)*d,y=p.y+Math.sin(ang)*d*.72,len=2+seeded(o.seed+i*29)*6;ctx.save();ctx.translate(x,y);ctx.rotate(seeded(o.seed+i*37)*Math.PI);ctx.fillStyle=`rgba(207,218,255,${(.09+seeded(o.seed+i)*.28)*a})`;ctx.beginPath();ctx.ellipse(0,0,len,len*.34,0,0,Math.PI*2);ctx.fill();ctx.restore()}ctx.beginPath();ctx.strokeStyle=`rgba(190,205,255,${.08*a})`;ctx.arc(p.x,p.y,r*.78,0,Math.PI*2);ctx.stroke()}
    function drawGroup(o:AtlasObject,a:number){if(!ctx)return;const p=worldToScreen(o.x,o.y),r=o.size*state.zoom*.48;ctx.save();ctx.setLineDash([4,9]);ctx.strokeStyle=`rgba(135,174,255,${.24*a})`;ctx.beginPath();ctx.ellipse(p.x,p.y,r,r*.64,-.15,0,Math.PI*2);ctx.stroke();ctx.restore()}
    function drawConstellation(o:AtlasObject,a:number){if(!ctx)return;const pts=constellationLines[o.id];if(!pts)return;const s=pts.map(p=>worldToScreen(p.x,p.y));ctx.save();ctx.strokeStyle=`rgba(188,220,255,${.28*a})`;ctx.beginPath();s.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));ctx.stroke();s.forEach((p,i)=>{ctx.beginPath();ctx.fillStyle=`rgba(235,245,255,${(.72+(i%2)*.2)*a})`;ctx.shadowBlur=9;ctx.shadowColor='rgba(150,205,255,.7)';ctx.arc(p.x,p.y,1.5+(i%3)*.8,0,Math.PI*2);ctx.fill()});ctx.restore()}
    function drawLabel(o:AtlasObject,a:number){if(!ctx||a<.12)return;const p=worldToScreen(o.x,o.y),selected=o.id===state.selectedId,hovered=o.id===state.hoverId,alpha=clamp(a*(selected||hovered?1.3:.82),0,1),offset=Math.max(12,o.size*state.zoom*(o.type==='galaxy'?.12:.22));ctx.font='600 10px Inter,system-ui,sans-serif';ctx.fillStyle=`rgba(231,240,255,${alpha})`;ctx.fillText(o.name.toUpperCase(),p.x+offset,p.y-4);ctx.font='500 8px Inter,system-ui,sans-serif';ctx.fillStyle=`rgba(151,169,198,${alpha*.72})`;ctx.fillText(o.band,p.x+offset,p.y+10);if(selected||hovered){ctx.beginPath();ctx.strokeStyle=o.accent;ctx.globalAlpha=.58*alpha;ctx.arc(p.x,p.y,8+o.size*state.zoom*.08,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=1}}
    function drawObjects(){const visible=objects.map(object=>({object,opacity:objectOpacity(object)})).filter(v=>v.opacity>.015).sort((a,b)=>a.object.size-b.object.size);visible.forEach(({object:o,opacity:a})=>{if(o.type==='group')drawGroup(o,a);if(o.type==='galaxy-cluster')drawGalaxyCluster(o,a);if(o.type==='galaxy')drawGalaxy(o,a);if(o.type==='nebula')drawNebula(o,a);if(o.type==='cluster')drawStarCluster(o,a);if(o.type==='constellation')drawConstellation(o,a)});visible.forEach(({object,opacity})=>drawLabel(object,opacity));if(visibleLabel)visibleLabel.textContent=`${String(visible.filter(v=>v.opacity>.18).length).padStart(2,'0')} / ${objects.length}`}

    function currentLevel(){let best=levels[0],distance=Infinity;for(const level of levels){const d=Math.abs(Math.log(state.zoom)-Math.log(level.zoom));if(d<distance){distance=d;best=level}}return best}
    function updateHud(){const level=currentLevel();if(levelLabel)levelLabel.textContent=level.label;if(miniScale)miniScale.textContent=level.label;if(zoomLabel)zoomLabel.textContent=`${state.zoom.toFixed(2)}×`;const x=Math.round(state.cameraX),y=Math.round(state.cameraY);if(positionLabel)positionLabel.textContent=`${x>=0?'+':'−'}${String(Math.abs(x)).padStart(3,'0')} / ${y>=0?'+':'−'}${String(Math.abs(y)).padStart(3,'0')}`;const min=Math.log(.13),max=Math.log(7.5),t=clamp((Math.log(state.zoom)-min)/(max-min),0,1);if(scaleMarker)scaleMarker.style.top=`${(1-t)*100}%`;levelButtons.forEach(button=>{const index=Number(button.dataset.level||0);button.classList.toggle('active',levels[index]?.label===level.label)})}
    function drawMiniMap(){if(!miniCtx||!miniMap)return;const w=miniMap.width,h=miniMap.height;miniCtx.clearRect(0,0,w,h);miniCtx.fillStyle='rgba(3,8,18,.82)';miniCtx.fillRect(0,0,w,h);const scale=.095,cx=w/2,cy=h/2;objects.filter(o=>['galaxy','group','galaxy-cluster'].includes(o.type)).forEach(o=>{const x=cx+o.x*scale,y=cy+o.y*scale;miniCtx.beginPath();miniCtx.fillStyle=o.type==='galaxy-cluster'?'rgba(229,188,255,.58)':o.type==='group'?'rgba(116,166,255,.38)':'rgba(201,225,255,.7)';miniCtx.arc(x,y,o.type==='galaxy-cluster'?2.4:1.7,0,Math.PI*2);miniCtx.fill()});const vw=state.width/state.zoom*scale,vh=state.height/state.zoom*scale;miniCtx.strokeStyle='rgba(161,207,255,.72)';miniCtx.strokeRect(cx+state.cameraX*scale-vw/2,cy+state.cameraY*scale-vh/2,vw,vh);miniCtx.beginPath();miniCtx.fillStyle='rgba(220,240,255,.9)';miniCtx.arc(cx+state.cameraX*scale,cy+state.cameraY*scale,1.8,0,Math.PI*2);miniCtx.fill()}
    function render(now:number){if(!ctx)return;state.time=now;const ease=reducedMotion?1:.11;state.cameraX=lerp(state.cameraX,state.targetCameraX,ease);state.cameraY=lerp(state.cameraY,state.targetCameraY,ease);state.zoom=lerp(state.zoom,state.targetZoom,reducedMotion?1:.1);ctx.clearRect(0,0,state.width,state.height);drawBackgroundStars();drawDust();drawObjects();updateHud();drawMiniMap();requestAnimationFrame(render)}

    function zoomAt(x:number,y:number,factor:number){const before=screenToWorld(x,y),next=clamp(state.targetZoom*factor,.13,7.5);state.targetZoom=next;const afterX=state.targetCameraX+(x-state.width*.5)/next,afterY=state.targetCameraY+(y-state.height*.5)/next;state.targetCameraX=clamp(state.targetCameraX+before.x-afterX,-980,980);state.targetCameraY=clamp(state.targetCameraY+before.y-afterY,-760,760);note?.classList.add('hidden')}
    function nearestObject(x:number,y:number){let nearest:AtlasObject|null=null,distance=42;for(const o of objects){const opacity=objectOpacity(o);if(opacity<.18)continue;const p=worldToScreen(o.x,o.y),d=Math.hypot(x-p.x,y-p.y),hit=Math.max(24,Math.min(80,o.size*state.zoom*.22));if(d<Math.min(distance,hit)){nearest=o;distance=d}}return nearest}
    function updateHover(x:number,y:number){if(state.dragging||state.pointers.size>1)return;const o=nearestObject(x,y);state.hoverId=o?.id??'';if(cursorLabel){if(o){cursorLabel.textContent=o.name;cursorLabel.style.transform=`translate3d(${x+18}px,${y+18}px,0)`;cursorLabel.classList.add('show');stage?.classList.add('has-target')}else{cursorLabel.classList.remove('show');stage?.classList.remove('has-target')}}}
    function selectObject(o:AtlasObject){state.selectedId=o.id;if(objectKind)objectKind.textContent=o.band;if(objectName)objectName.textContent=o.name;if(objectDistance)objectDistance.textContent=o.distance;if(objectCopy)objectCopy.textContent=o.copy;if(objectMap)objectMap.textContent=`${o.x>=0?'+':'−'}${Math.abs(o.x)} / ${o.y>=0?'+':'−'}${Math.abs(o.y)}`;if(objectBand)objectBand.textContent=o.band;objectPanel?.classList.add('open')}
    function resetView(){state.targetCameraX=20;state.targetCameraY=10;state.targetZoom=.95;state.selectedId='';objectPanel?.classList.remove('open')}
    function focusLevel(index:number){const level=levels[index];if(!level)return;state.targetZoom=level.zoom;if(index<=1){state.targetCameraX=20;state.targetCameraY=0}else if(index===2){state.targetCameraX=70;state.targetCameraY=0}else if(index===3){state.targetCameraX=-80;state.targetCameraY=30}else{state.targetCameraX=20;state.targetCameraY=-20}intro?.classList.add('gone')}
    function pointerDistance(){const pts=[...state.pointers.values()];return pts.length<2?0:Math.hypot(pts[0].x-pts[1].x,pts[0].y-pts[1].y)}

    canvas?.addEventListener('wheel',e=>{e.preventDefault();zoomAt(e.clientX,e.clientY,Math.exp(-e.deltaY*.0012));intro?.classList.add('gone')},{passive:false});
    canvas?.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);state.pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(state.pointers.size===1){state.dragging=true;state.dragStartX=e.clientX;state.dragStartY=e.clientY;state.cameraStartX=state.targetCameraX;state.cameraStartY=state.targetCameraY;stage?.classList.add('dragging')}else if(state.pointers.size===2){state.pinchDistance=pointerDistance();state.pinchZoom=state.targetZoom;state.dragging=false}});
    canvas?.addEventListener('pointermove',e=>{if(state.pointers.has(e.pointerId))state.pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(state.pointers.size===2){const d=pointerDistance();if(state.pinchDistance>0)state.targetZoom=clamp(state.pinchZoom*(d/state.pinchDistance),.13,7.5);intro?.classList.add('gone');return}if(state.dragging){const dx=(e.clientX-state.dragStartX)/state.targetZoom,dy=(e.clientY-state.dragStartY)/state.targetZoom;state.targetCameraX=clamp(state.cameraStartX-dx,-980,980);state.targetCameraY=clamp(state.cameraStartY-dy,-760,760);note?.classList.add('hidden');intro?.classList.add('gone')}else updateHover(e.clientX,e.clientY)});
    function endPointer(e:PointerEvent){const moved=Math.hypot(e.clientX-state.dragStartX,e.clientY-state.dragStartY);state.pointers.delete(e.pointerId);if(state.pointers.size<2)state.pinchDistance=0;if(state.pointers.size===0){if(state.dragging&&moved<7){const o=nearestObject(e.clientX,e.clientY);if(o)selectObject(o)}state.dragging=false;stage?.classList.remove('dragging')}}
    canvas?.addEventListener('pointerup',endPointer);canvas?.addEventListener('pointercancel',endPointer);canvas?.addEventListener('pointerleave',()=>{if(!state.dragging){state.hoverId='';cursorLabel?.classList.remove('show');stage?.classList.remove('has-target')}});
    enterButton?.addEventListener('click',()=>{intro?.classList.add('gone');state.targetZoom=1.65;state.targetCameraX=-80;state.targetCameraY=20;note?.classList.remove('hidden')});
    resetButton?.addEventListener('click',resetView);zoomInButton?.addEventListener('click',()=>zoomAt(state.width*.5,state.height*.5,1.45));zoomOutButton?.addEventListener('click',()=>zoomAt(state.width*.5,state.height*.5,1/1.45));panelClose?.addEventListener('click',()=>{objectPanel?.classList.remove('open');state.selectedId=''});levelButtons.forEach(button=>button.addEventListener('click',()=>focusLevel(Number(button.dataset.level||0))));window.addEventListener('resize',resize);
    resize();requestAnimationFrame(render);
  </script>
</BaseLayout>


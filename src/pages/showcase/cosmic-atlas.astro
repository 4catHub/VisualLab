  .mouse-icon { width:17px; height:25px; border:1px solid #6d82a3; border-radius:9px; position:relative; } .mouse-icon i { position:absolute; left:7px; top:5px; width:1px; height:6px; background:#9cb9dc; animation:wheelMove 1.8s ease-in-out infinite; }

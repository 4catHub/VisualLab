  .mini-head { height:28px; display:flex; align-items:center; justify-content:space-between; padding:0 9px; border-bottom:1px solid rgba(173,205,255,.1); font-size:.46rem; letter-spacing:.14em; color:#8192ad; } .mini-head i{font-style:normal;color:#b8cce4} #miniMap{width:220px;height:128px}

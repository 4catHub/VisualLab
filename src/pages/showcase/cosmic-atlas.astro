  .zoom-controls { position:absolute; z-index:10; right:24px; bottom:170px; display:grid; gap:6px; } .zoom-controls button { width:34px; height:34px; border:1px solid rgba(173,205,255,.14); background:rgba(3,8,18,.58); color:#dceeff; font-size:1rem; cursor:pointer; backdrop-filter:blur(10px); } .zoom-controls button:hover{background:rgba(173,205,255,.09)}

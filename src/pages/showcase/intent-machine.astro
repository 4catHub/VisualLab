---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intent Machine — VisualLab"
  description="의도에 따라 인터페이스의 형태가 생성되고 해체되는 ZERO UI 실험."
  className="intent-machine-page"
>
  <main class="machine" id="intentMachine" data-state="idle" data-intent="">
    <div class="grid" aria-hidden="true"></div>

    <header class="machine-bar">
      <a href="/" class="brand">← VisualLab</a>
      <span>INTENT MACHINE / 007</span>
      <span class="state" id="machineState"><i></i>IDLE</span>
    </header>

    <section class="zero" id="zeroState" aria-labelledby="zeroTitle">
      <div class="zero-copy">
        <p class="eyebrow">ZERO UI / GENERATIVE INTERFACE</p>
        <h1 id="zeroTitle">What should<br />this become?</h1>
        <p class="lede">필요한 기능을 먼저 고르지 마세요. 지금 하려는 일을 고르면, 화면이 그 목적에 맞는 인터페이스로 다시 조립됩니다.</p>
      </div>

      <form class="command" id="intentForm">
        <label for="intentInput">STATE YOUR INTENT</label>
        <div class="command-line">
          <span aria-hidden="true">›</span>
          <input
            id="intentInput"
            name="intent"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="explore / focus / compare / play"
            aria-describedby="commandHint"
          />
          <button type="submit">ENTER</button>
        </div>
        <p id="commandHint">단어를 입력하거나 아래의 intent를 선택하세요.</p>
      </form>

      <div class="intent-picks" aria-label="Intent presets">
        <button type="button" data-intent="explore"><b>01</b><span>EXPLORE</span><small>넓게 보고 연결하기</small></button>
        <button type="button" data-intent="focus"><b>02</b><span>FOCUS</span><small>하나만 남기기</small></button>
        <button type="button" data-intent="compare"><b>03</b><span>COMPARE</span><small>차이를 나란히 읽기</small></button>
        <button type="button" data-intent="play"><b>04</b><span>PLAY</span><small>규칙을 바꾸며 탐색하기</small></button>
      </div>

      <div class="zero-meta">
        <span>NO FIXED NAVIGATION</span>
        <span>UI IS A RESPONSE</span>
        <span>ESC TO RESET</span>
      </div>
    </section>

    <section class="workspace" id="workspace" aria-live="polite" aria-hidden="true">
      <header class="context">
        <button class="back-to-zero" id="backToZero" type="button">← ZERO</button>
        <div>
          <span id="intentIndex">01 / 04</span>
          <strong id="intentName">EXPLORE</strong>
        </div>
        <p id="intentDescription">관계를 찾기 위해 화면을 넓힙니다.</p>
      </header>

      <div class="mode mode-explore" data-mode="explore">
        <div class="mode-head">
          <p>EXPLORE MODE</p>
          <h2>Nothing is primary<br />until you choose it.</h2>
        </div>

        <div class="explore-board" id="exploreBoard" data-selected="signal">
          <div class="network-lines" aria-hidden="true"></div>
          <div class="explore-signal" aria-hidden="true">
            <span id="exploreGhost">SIGNAL</span>
            <small id="exploreCode">01 / 76</small>
          </div>
          <button class="node n1 is-active" type="button" data-node="signal"><i></i><span>SIGNAL</span><small>01</small></button>
          <button class="node n2" type="button" data-node="context"><i></i><span>CONTEXT</span><small>02</small></button>
          <button class="node n3" type="button" data-node="memory"><i></i><span>MEMORY</span><small>03</small></button>
          <button class="node n4" type="button" data-node="friction"><i></i><span>FRICTION</span><small>04</small></button>
          <button class="node n5" type="button" data-node="pattern"><i></i><span>PATTERN</span><small>05</small></button>
          <button class="node n6" type="button" data-node="edge"><i></i><span>EDGE</span><small>06</small></button>
          <button class="node n7" type="button" data-node="unknown"><i></i><span>UNKNOWN</span><small>07</small></button>
          <aside class="node-detail">
            <span>SELECTED / 01</span>
            <strong id="nodeTitle">SIGNAL</strong>
            <h3 id="nodeQuestion">What catches your attention first?</h3>
            <p id="nodeCopy">강한 신호에서 시작하지만, 연결된 주변 맥락이 의미를 바꿉니다.</p>
            <div class="node-relation">
              <small>RELATED</small>
              <b id="nodeRelated">CONTEXT · PATTERN</b>
            </div>
            <div class="node-meter"><i id="nodeMeter"></i></div>
          </aside>
        </div>
      </div>

      <div class="mode mode-focus" data-mode="focus">
        <div class="focus-rail">
          <span>FOCUS DEPTH</span>
          <input id="focusDepth" type="range" min="0" max="100" value="72" aria-label="Focus depth" />
          <strong id="focusValue">72%</strong>
        </div>

        <article class="focus-card">
          <p class="focus-kicker">ONE ACTIVE OBJECT</p>
          <h2>Reduce until<br />the next action<br />is obvious.</h2>
          <p>FOCUS 모드는 주변의 선택지를 제거하고 지금 필요한 문장과 하나의 행동만 남깁니다. 슬라이더를 올릴수록 보조 정보가 더 조용해집니다.</p>
          <div class="focus-scale-copy" aria-hidden="true">
            <span>0 — CONTEXT</span>
            <i></i>
            <span>100 — ONLY NEXT ACTION</span>
          </div>
        </article>

        <div class="focus-noise" aria-hidden="true">
          <span>RECENT</span><span>FILTERS</span><span>SHORTCUTS</span><span>HISTORY</span><span>RELATED</span><span>TOOLS</span>
        </div>

        <div class="focus-status">
          <span>VISIBLE OBJECTS</span>
          <strong id="visibleObjects">03</strong>
        </div>
      </div>

      <div class="mode mode-compare" data-mode="compare">
        <div class="mode-head compare-head">
          <p>COMPARE MODE</p>
          <h2>One decision.<br />Two readings.</h2>
        </div>

        <div class="compare-stage" id="compareStage">
          <article class="comparison comparison-a">
            <span class="comparison-tag">A / DENSE</span>
            <div class="sample-nav"><i></i><i></i><i></i></div>
            <h3>Everything<br />available.</h3>
            <p>필터, 상태, 세부 조작을 항상 노출하는 고밀도 인터페이스.</p>
            <div class="sample-table" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </article>

          <article class="comparison comparison-b">
            <span class="comparison-tag">B / QUIET</span>
            <div class="sample-dot"></div>
            <h3>Only what<br />matters now.</h3>
            <p>현재 맥락에 필요한 조작만 등장하는 의도 중심 인터페이스.</p>
          </article>

          <div class="compare-divider" aria-hidden="true"><i></i></div>
          <input id="compareRange" class="compare-range" type="range" min="14" max="86" value="50" aria-label="Compare interface split" />
        </div>

        <div class="compare-readout">
          <span>A <strong id="compareA">50</strong>%</span>
          <p>CLICK OR DRAG ANYWHERE</p>
          <span>B <strong id="compareB">50</strong>%</span>
        </div>
      </div>

      <div class="mode mode-play" data-mode="play">
        <header class="play-head">
          <div>
            <p>PLAY MODE</p>
            <h2>Change the rule,<br />not the content.</h2>
          </div>
          <button id="mutateButton" type="button">MUTATE <span>↻</span></button>
        </header>

        <div class="play-grid" id="playGrid" data-variant="0">
          <button class="play-block block-a" type="button" data-play-variant="0"><span>01</span><strong>MOVE</strong><i></i></button>
          <button class="play-block block-b" type="button" data-play-variant="2"><span>02</span><strong>STACK</strong><i></i></button>
          <button class="play-block block-c" type="button" data-play-variant="1"><span>03</span><strong>FLIP</strong><i></i></button>
          <button class="play-block block-d" type="button" data-play-variant="3"><span>04</span><strong>GROW</strong><i></i></button>
          <div class="play-block block-e" aria-hidden="true"><span>RULE</span><strong id="ruleName">GRID / 01</strong></div>
          <div class="play-block block-f" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </div>

      <nav class="intent-dock" aria-label="Switch intent">
        <button type="button" data-intent="explore"><b>1</b><span>Explore</span></button>
        <button type="button" data-intent="focus"><b>2</b><span>Focus</span></button>
        <button type="button" data-intent="compare"><b>3</b><span>Compare</span></button>
        <button type="button" data-intent="play"><b>4</b><span>Play</span></button>
      </nav>
    </section>

    <div class="assembler" id="assembler" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
      <strong id="assemblerLabel">ASSEMBLING INTERFACE</strong>
    </div>
  </main>

  <script>
    type IntentName = 'explore' | 'focus' | 'compare' | 'play';

    const root = document.querySelector<HTMLElement>('#intentMachine');
    const workspace = document.querySelector<HTMLElement>('#workspace');
    const zero = document.querySelector<HTMLElement>('#zeroState');
    const form = document.querySelector<HTMLFormElement>('#intentForm');
    const input = document.querySelector<HTMLInputElement>('#intentInput');
    const stateLabel = document.querySelector<HTMLElement>('#machineState');
    const nameLabel = document.querySelector<HTMLElement>('#intentName');
    const indexLabel = document.querySelector<HTMLElement>('#intentIndex');
    const descriptionLabel = document.querySelector<HTMLElement>('#intentDescription');
    const assemblerLabel = document.querySelector<HTMLElement>('#assemblerLabel');
    const backButton = document.querySelector<HTMLButtonElement>('#backToZero');
    const intentButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-intent]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const intents: Record<IntentName, { index: string; label: string; description: string }> = {
      explore: { index: '01 / 04', label: 'EXPLORE', description: '관계를 찾기 위해 화면을 넓힙니다.' },
      focus: { index: '02 / 04', label: 'FOCUS', description: '주변을 줄여 하나의 다음 행동만 남깁니다.' },
      compare: { index: '03 / 04', label: 'COMPARE', description: '같은 대상을 두 구조로 나눠 차이를 드러냅니다.' },
      play: { index: '04 / 04', label: 'PLAY', description: '콘텐츠는 유지하고 인터페이스 규칙만 바꿉니다.' }
    };

    let transitionTimer = 0;

    function isIntent(value: string): value is IntentName {
      return value === 'explore' || value === 'focus' || value === 'compare' || value === 'play';
    }

    function syncIntentControls(intent: IntentName) {
      intentButtons.forEach((button) => {
        const current = button.dataset.intent === intent;
        button.classList.toggle('is-current', current);
        if (button.closest('.intent-dock')) button.setAttribute('aria-pressed', String(current));
      });
    }

    function setIntent(intent: IntentName) {
      if (!root || !workspace || !zero) return;
      const data = intents[intent];
      const firstEntry = root.dataset.state === 'idle' || !root.dataset.intent;

      if (!firstEntry && root.dataset.intent === intent) {
        syncIntentControls(intent);
        return;
      }

      window.clearTimeout(transitionTimer);
      root.dataset.intent = intent;
      zero.setAttribute('aria-hidden', 'true');
      workspace.setAttribute('aria-hidden', 'false');

      if (nameLabel) nameLabel.textContent = data.label;
      if (indexLabel) indexLabel.textContent = data.index;
      if (descriptionLabel) descriptionLabel.textContent = data.description;
      syncIntentControls(intent);

      if (firstEntry && !reducedMotion) {
        root.dataset.state = 'building';
        if (stateLabel) stateLabel.innerHTML = '<i></i>BUILDING';
        if (assemblerLabel) assemblerLabel.textContent = 'ASSEMBLING ' + data.label + ' INTERFACE';
        transitionTimer = window.setTimeout(() => {
          root.dataset.state = 'active';
          if (stateLabel) stateLabel.innerHTML = '<i></i>' + data.label;
        }, 620);
      } else {
        root.dataset.state = 'active';
        if (stateLabel) stateLabel.innerHTML = '<i></i>' + data.label;
      }
    }

    function resetMachine() {
      if (!root || !workspace || !zero) return;
      window.clearTimeout(transitionTimer);
      root.dataset.state = 'idle';
      root.dataset.intent = '';
      zero.setAttribute('aria-hidden', 'false');
      workspace.setAttribute('aria-hidden', 'true');
      if (stateLabel) stateLabel.innerHTML = '<i></i>IDLE';
      intentButtons.forEach((button) => {
        button.classList.remove('is-current');
        if (button.closest('.intent-dock')) button.setAttribute('aria-pressed', 'false');
      });
      if (input) {
        input.value = '';
        window.setTimeout(() => input.focus(), 120);
      }
    }

    intentButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const intent = button.dataset.intent ?? '';
        if (isIntent(intent)) setIntent(intent);
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = (input?.value ?? '').trim().toLowerCase();
      const aliases: Record<string, IntentName> = {
        browse: 'explore', search: 'explore', map: 'explore',
        concentrate: 'focus', read: 'focus', work: 'focus',
        versus: 'compare', vs: 'compare', decide: 'compare',
        experiment: 'play', random: 'play', remix: 'play'
      };
      const intent = isIntent(value) ? value : aliases[value];
      if (intent) {
        setIntent(intent);
        return;
      }
      input?.classList.remove('shake');
      requestAnimationFrame(() => input?.classList.add('shake'));
    });

    backButton?.addEventListener('click', resetMachine);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        resetMachine();
        return;
      }

      const target = event.target as HTMLElement | null;
      const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable;
      if (!isTyping && ['1', '2', '3', '4'].includes(event.key)) {
        const intent = (['explore', 'focus', 'compare', 'play'] as IntentName[])[Number(event.key) - 1];
        if (intent) setIntent(intent);
      }
    });

    const nodeData: Record<string, { title: string; question: string; copy: string; related: string[]; meter: number; index: string; x: number; y: number; shiftX: number; shiftY: number }> = {
      signal: { title: 'SIGNAL', question: 'What catches your attention first?', copy: '강한 신호는 탐색의 시작점입니다. SIGNAL을 중심으로 CONTEXT와 PATTERN이 가까워지며 무엇을 더 살펴볼지 드러냅니다.', related: ['context', 'pattern'], meter: 76, index: '01', x: 18, y: 26, shiftX: -10, shiftY: -5 },
      context: { title: 'CONTEXT', question: 'What changes the meaning around it?', copy: '같은 신호도 주변 맥락에 따라 다르게 읽힙니다. SIGNAL과 MEMORY를 가까이 두고 판단의 배경을 탐색합니다.', related: ['signal', 'memory'], meter: 58, index: '02', x: 44, y: 18, shiftX: 5, shiftY: -8 },
      memory: { title: 'MEMORY', question: 'What should the interface remember?', copy: '과거 선택은 다음 선택의 우선순위를 만듭니다. PATTERN과 CONTEXT가 가까워지고 반복의 흔적이 중심으로 들어옵니다.', related: ['pattern', 'context'], meter: 68, index: '03', x: 68, y: 28, shiftX: 12, shiftY: -3 },
      friction: { title: 'FRICTION', question: 'Where do you hesitate?', copy: '멈칫하는 지점은 제거할 오류만이 아닙니다. UNKNOWN과 EDGE가 가까워지며 어떤 경계가 행동을 방해하는지 보여줍니다.', related: ['unknown', 'edge'], meter: 43, index: '04', x: 33, y: 67, shiftX: -4, shiftY: 10 },
      pattern: { title: 'PATTERN', question: 'What keeps happening again?', copy: '반복된 행동이 보이면 인터페이스는 그 행동을 앞으로 가져올 수 있습니다. MEMORY와 SIGNAL이 연결됩니다.', related: ['memory', 'signal'], meter: 82, index: '05', x: 57, y: 60, shiftX: 8, shiftY: 8 },
      edge: { title: 'EDGE', question: 'What lives just outside the current view?', copy: '주변부의 선택지는 필요해지는 순간 중심으로 이동합니다. FRICTION과 UNKNOWN이 함께 가까워집니다.', related: ['friction', 'unknown'], meter: 35, index: '06', x: 66, y: 72, shiftX: 13, shiftY: 12 },
      unknown: { title: 'UNKNOWN', question: 'What if the intent is still unclear?', copy: '의도를 확신할 수 없을 때는 결정을 강요하지 않습니다. FRICTION과 CONTEXT를 열어두고 다음 단서를 기다립니다.', related: ['friction', 'context'], meter: 51, index: '07', x: 14, y: 76, shiftX: -12, shiftY: 13 }
    };
    const exploreBoard = document.querySelector<HTMLElement>('#exploreBoard');
    const exploreGhost = document.querySelector<HTMLElement>('#exploreGhost');
    const exploreCode = document.querySelector<HTMLElement>('#exploreCode');
    const nodeDetail = document.querySelector<HTMLElement>('.node-detail');
    const nodes = [...document.querySelectorAll<HTMLButtonElement>('.node')];
    const nodeTitle = document.querySelector<HTMLElement>('#nodeTitle');
    const nodeQuestion = document.querySelector<HTMLElement>('#nodeQuestion');
    const nodeCopy = document.querySelector<HTMLElement>('#nodeCopy');
    const nodeRelated = document.querySelector<HTMLElement>('#nodeRelated');
    const nodeMeter = document.querySelector<HTMLElement>('#nodeMeter');

    const relationPositions = [
      { left: 14, top: 16 },
      { left: 52, top: 14 },
      { left: 16, top: 64 },
      { left: 50, top: 67 }
    ];

    function arrangeExplore(selectedKey: string) {
      const selected = nodeData[selectedKey];
      if (!selected) return;

      const related = new Set(selected.related);
      let relatedIndex = 0;
      let outerIndex = 0;
      const outerPositions = [
        { left: 4, top: 39 },
        { left: 66, top: 46 },
        { left: 37, top: 76 },
        { left: 73, top: 15 }
      ];

      nodes.forEach((item) => {
        const key = item.dataset.node ?? '';
        item.classList.toggle('is-related', related.has(key));
        item.classList.toggle('is-distant', key !== selectedKey && !related.has(key));

        if (key === selectedKey) {
          item.style.left = '33%';
          item.style.top = '37%';
          return;
        }

        const position = related.has(key)
          ? relationPositions[relatedIndex++ % relationPositions.length]
          : outerPositions[outerIndex++ % outerPositions.length];
        item.style.left = position.left + '%';
        item.style.top = position.top + '%';
      });
    }

    nodes.forEach((node) => node.addEventListener('click', () => {
      const key = node.dataset.node ?? '';
      const data = nodeData[key];
      if (!data) return;
      nodes.forEach((item) => {
        const active = item === node;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      if (exploreBoard) {
        exploreBoard.dataset.selected = key;
        exploreBoard.style.setProperty('--explore-x', data.x + '%');
        exploreBoard.style.setProperty('--explore-y', data.y + '%');
        exploreBoard.style.setProperty('--explore-shift-x', data.shiftX + 'px');
        exploreBoard.style.setProperty('--explore-shift-y', data.shiftY + 'px');
      }
      if (exploreGhost) exploreGhost.textContent = data.title;
      if (exploreCode) exploreCode.textContent = data.index + ' / ' + String(data.meter).padStart(2, '0');
      arrangeExplore(key);
      if (nodeDetail) nodeDetail.querySelector(':scope > span')!.textContent = 'SELECTED / ' + data.index;
      if (nodeTitle) nodeTitle.textContent = data.title;
      if (nodeQuestion) nodeQuestion.textContent = data.question;
      if (nodeCopy) nodeCopy.textContent = data.copy;
      if (nodeRelated) nodeRelated.textContent = data.related.map((relatedKey) => nodeData[relatedKey]?.title ?? relatedKey).join(' · ');
      if (nodeMeter) nodeMeter.style.width = data.meter + '%';

      nodeDetail?.classList.remove('is-changing');
      requestAnimationFrame(() => nodeDetail?.classList.add('is-changing'));
    }));

    const focusDepth = document.querySelector<HTMLInputElement>('#focusDepth');
    const focusValue = document.querySelector<HTMLElement>('#focusValue');
    const visibleObjects = document.querySelector<HTMLElement>('#visibleObjects');

    function updateFocus() {
      const value = Math.min(100, Math.max(0, Number(focusDepth?.value ?? 72)));
      const strength = value / 100;
      root?.style.setProperty('--focus', String(strength));
      root?.style.setProperty('--focus-noise-opacity', String(.03 + (1 - strength) * .82));
      root?.style.setProperty('--focus-blur', (strength * 4).toFixed(2) + 'px');
      root?.style.setProperty('--focus-border', (10 + strength * 24).toFixed(1) + '%');
      root?.style.setProperty('--focus-shadow', (2 + strength * 8).toFixed(1) + '%');
      root?.style.setProperty('--focus-scale', String(1 + strength * .018));
      if (focusValue) focusValue.textContent = value + '%';
      if (visibleObjects) visibleObjects.textContent = String(Math.max(1, Math.round(9 - strength * 8))).padStart(2, '0');
    }
    focusDepth?.addEventListener('input', updateFocus);

    const compareStage = document.querySelector<HTMLElement>('#compareStage');
    const compareRange = document.querySelector<HTMLInputElement>('#compareRange');
    const compareA = document.querySelector<HTMLElement>('#compareA');
    const compareB = document.querySelector<HTMLElement>('#compareB');
    let draggingCompare = false;

    function updateCompare(valueOverride?: number) {
      const value = Math.min(86, Math.max(14, valueOverride ?? Number(compareRange?.value ?? 50)));
      if (compareRange) compareRange.value = String(Math.round(value));
      root?.style.setProperty('--split', value + '%');
      if (compareA) compareA.textContent = String(Math.round(value));
      if (compareB) compareB.textContent = String(Math.round(100 - value));
    }

    function setCompareFromPointer(clientX: number) {
      if (!compareStage) return;
      const rect = compareStage.getBoundingClientRect();
      if (!rect.width) return;
      updateCompare(((clientX - rect.left) / rect.width) * 100);
    }

    compareRange?.addEventListener('input', () => updateCompare());
    compareStage?.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('button')) return;
      draggingCompare = true;
      compareStage.setPointerCapture(event.pointerId);
      setCompareFromPointer(event.clientX);
    });
    compareStage?.addEventListener('pointermove', (event) => {
      if (draggingCompare) setCompareFromPointer(event.clientX);
    });
    compareStage?.addEventListener('pointerup', (event) => {
      draggingCompare = false;
      if (compareStage.hasPointerCapture(event.pointerId)) compareStage.releasePointerCapture(event.pointerId);
    });
    compareStage?.addEventListener('pointercancel', () => {
      draggingCompare = false;
    });


    const playGrid = document.querySelector<HTMLElement>('#playGrid');
    const mutateButton = document.querySelector<HTMLButtonElement>('#mutateButton');
    const ruleName = document.querySelector<HTMLElement>('#ruleName');
    const playButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-play-variant]')];
    let variant = 0;

    function setPlayVariant(next: number) {
      variant = Math.min(3, Math.max(0, next));
      if (playGrid) playGrid.dataset.variant = String(variant);
      if (ruleName) ruleName.textContent = ['GRID / 01', 'ORBIT / 02', 'STACK / 03', 'FLOW / 04'][variant] ?? 'GRID / 01';
      playButtons.forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.playVariant) === variant)));
    }

    mutateButton?.addEventListener('click', () => setPlayVariant((variant + 1) % 4));
    playButtons.forEach((button) => button.addEventListener('click', () => {
      setPlayVariant(Number(button.dataset.playVariant ?? 0));
    }));

    nodes.forEach((node) => node.setAttribute('aria-pressed', String(node.classList.contains('is-active'))));
    arrangeExplore('signal');
    intentButtons.filter((button) => button.closest('.intent-dock')).forEach((button) => button.setAttribute('aria-pressed', 'false'));
    updateFocus();
    updateCompare();
    setPlayVariant(0);

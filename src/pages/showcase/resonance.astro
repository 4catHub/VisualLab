---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Resonance — VisualLab"
  description="A sound-reactive light field that turns system audio or microphone input into flowing waves, particles, and luminous resonance."
  className="resonance-page"
>
  <main class="resonance" id="resonance">
    <canvas id="visualCanvas" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="/" aria-label="VisualLab index">
        <span class="brand-mark"></span>
        <span>VisualLab</span>
      </a>
      <div class="top-meta">
        <span>RESONANCE / 006</span>
        <span class="signal-dot" id="signalDot"></span>
        <span id="topState">DORMANT</span>
      </div>
    </header>

    <section class="intro" id="intro" aria-labelledby="resonanceTitle">
      <div class="intro-copy">
        <p class="eyebrow">Audio reactive field</p>
        <h1 id="resonanceTitle">HEAR<br /><em>THE LIGHT.</em></h1>
        <p class="lede">
          소리는 보이지 않지만 공간을 흔듭니다. 지금 재생되는 소리의 에너지와 결을 빛, 파동, 입자의 밀도로 번역합니다.
        </p>
      </div>

      <div class="access-panel" id="accessPanel">
        <div class="panel-head">
          <span>INPUT CHANNEL</span>
          <span id="deviceLabel">DETECTING</span>
        </div>
        <div class="input-orb" id="inputOrb" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="orb-core"></span>
        </div>
        <div class="panel-copy">
          <strong id="permissionTitle">소리 입력을 연결합니다.</strong>
          <p id="permissionCopy">기기를 확인한 뒤 사용할 수 있는 하나의 입력만 요청합니다.</p>
        </div>
        <button class="listen-button" id="listenButton" type="button">
          <span id="listenLabel">CONNECT AUDIO</span>
          <span aria-hidden="true">↗</span>
        </button>
        <p class="privacy-note" id="privacyNote">오디오는 브라우저 안에서만 분석되며 저장되거나 전송되지 않습니다.</p>
      </div>
    </section>

    <section class="hud" id="hud" aria-label="Audio analysis">
      <div class="hud-item hud-level">
        <span class="hud-label">LEVEL</span>
        <div class="level-row">
          <strong id="levelValue">00</strong>
          <div class="meter"><i id="meterFill"></i></div>
        </div>
      </div>
      <div class="hud-item">
        <span class="hud-label">LOW</span>
        <strong id="lowValue">00</strong>
      </div>
      <div class="hud-item">
        <span class="hud-label">MID</span>
        <strong id="midValue">00</strong>
      </div>
      <div class="hud-item">
        <span class="hud-label">HIGH</span>
        <strong id="highValue">00</strong>
      </div>
      <div class="hud-item hud-source">
        <span class="hud-label">SOURCE</span>
        <strong id="sourceValue">—</strong>
      </div>
    </section>

    <div class="frequency-scale" aria-hidden="true">
      <span>20HZ</span>
      <span>80</span>
      <span>320</span>
      <span>1.2K</span>
      <span>5K</span>
      <span>20KHZ</span>
    </div>

    <div class="hint" id="activeHint">소리를 재생하면 화면 전체가 반응합니다.</div>

    <button class="disconnect" id="disconnectButton" type="button">DISCONNECT</button>
  </main>

  <script>
    type AudioState = {
      context: AudioContext | null;
      analyser: AnalyserNode | null;
      source: MediaStreamAudioSourceNode | null;
      stream: MediaStream | null;
    };

    const canvas = document.querySelector<HTMLCanvasElement>('#visualCanvas');
    const root = document.querySelector<HTMLElement>('#resonance');
    const intro = document.querySelector<HTMLElement>('#intro');
    const accessPanel = document.querySelector<HTMLElement>('#accessPanel');
    const listenButton = document.querySelector<HTMLButtonElement>('#listenButton');
    const listenLabel = document.querySelector<HTMLElement>('#listenLabel');
    const permissionTitle = document.querySelector<HTMLElement>('#permissionTitle');
    const permissionCopy = document.querySelector<HTMLElement>('#permissionCopy');
    const privacyNote = document.querySelector<HTMLElement>('#privacyNote');
    const deviceLabel = document.querySelector<HTMLElement>('#deviceLabel');
    const sourceValue = document.querySelector<HTMLElement>('#sourceValue');
    const topState = document.querySelector<HTMLElement>('#topState');
    const disconnectButton = document.querySelector<HTMLButtonElement>('#disconnectButton');
    const activeHint = document.querySelector<HTMLElement>('#activeHint');
    const levelValue = document.querySelector<HTMLElement>('#levelValue');
    const lowValue = document.querySelector<HTMLElement>('#lowValue');
    const midValue = document.querySelector<HTMLElement>('#midValue');
    const highValue = document.querySelector<HTMLElement>('#highValue');
    const meterFill = document.querySelector<HTMLElement>('#meterFill');

    const ctx = canvas?.getContext('2d', { alpha: true });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
    const mobileUA = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
    const isMobile = coarsePointer || mobileUA;

    const audio: AudioState = {
      context: null,
      analyser: null,
      source: null,
      stream: null
    };

    let frequencyData = new Uint8Array(1024);
    let timeData = new Uint8Array(2048);
    let width = 1;
    let height = 1;
    let dpr = 1;
    let running = false;
    let frame = 0;
    let smoothLevel = 0;
    let smoothLow = 0;
    let smoothMid = 0;
    let smoothHigh = 0;
    let pulse = 0;
    let lastBeat = 0;

    interface Particle {
      x: number;
      y: number;
      angle: number;
      speed: number;
      radius: number;
      phase: number;
      depth: number;
    }

    const particles: Particle[] = Array.from({ length: 170 }, (_, index) => ({
      x: Math.random(),
      y: Math.random(),
      angle: Math.random() * Math.PI * 2,
      speed: .00015 + Math.random() * .00055,
      radius: .35 + Math.random() * 1.7,
      phase: Math.random() * Math.PI * 2,
      depth: .25 + Math.random() * .75 + (index % 7) * .012
    }));

    function setDeviceCopy() {
      if (deviceLabel) deviceLabel.textContent = isMobile ? 'MICROPHONE' : 'SYSTEM AUDIO';
      if (listenLabel) listenLabel.textContent = isMobile ? 'ALLOW MICROPHONE' : 'SHARE SYSTEM AUDIO';
      if (permissionTitle) permissionTitle.textContent = isMobile ? '마이크로 주변의 소리를 듣습니다.' : '현재 재생 중인 시스템 소리를 듣습니다.';
      if (permissionCopy) {
        permissionCopy.textContent = isMobile
          ? '마이크 권한을 허용하면 주변의 음악과 소리가 실시간으로 화면에 반영됩니다.'
          : '화면 공유 창에서 오디오 공유를 켜 주세요. 영상은 사용하지 않고 오디오 트랙만 분석합니다.';
      }
      if (sourceValue) sourceValue.textContent = isMobile ? 'MIC' : 'SYSTEM';
    }

    function resize() {
      if (!canvas || !ctx) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function getBand(data: Uint8Array, from: number, to: number) {
      if (!audio.context || !audio.analyser) return 0;
      const nyquist = audio.context.sampleRate / 2;
      const start = Math.max(0, Math.floor(from / nyquist * data.length));
      const end = Math.min(data.length - 1, Math.ceil(to / nyquist * data.length));
      let total = 0;
      let count = 0;
      for (let i = start; i <= end; i += 1) {
        total += data[i] ?? 0;
        count += 1;
      }
      return count ? total / count / 255 : 0;
    }

    function getRms(data: Uint8Array) {
      let sum = 0;
      for (let i = 0; i < data.length; i += 1) {
        const normalized = ((data[i] ?? 128) - 128) / 128;
        sum += normalized * normalized;
      }
      return Math.sqrt(sum / data.length);
    }

    function lerp(current: number, target: number, amount: number) {
      return current + (target - current) * amount;
    }

    function rounded(value: number) {
      return String(Math.round(Math.min(99, Math.max(0, value * 99)))).padStart(2, '0');
    }

    function updateAnalysis() {
      if (!audio.analyser) {
        smoothLevel = lerp(smoothLevel, 0.035, .025);
        smoothLow = lerp(smoothLow, 0.025, .025);
        smoothMid = lerp(smoothMid, 0.025, .025);
        smoothHigh = lerp(smoothHigh, 0.025, .025);
        return;
      }

      audio.analyser.getByteFrequencyData(frequencyData);
      audio.analyser.getByteTimeDomainData(timeData);

      const rms = Math.min(1, getRms(timeData) * 3.3);
      const low = getBand(frequencyData, 32, 180);
      const mid = getBand(frequencyData, 180, 2200);
      const high = getBand(frequencyData, 2200, 12000);

      smoothLevel = lerp(smoothLevel, rms, rms > smoothLevel ? .24 : .08);
      smoothLow = lerp(smoothLow, low, .14);
      smoothMid = lerp(smoothMid, mid, .12);
      smoothHigh = lerp(smoothHigh, high, .12);

      const now = performance.now();
      const beatThreshold = .48 + smoothMid * .08;
      if (smoothLow > beatThreshold && now - lastBeat > 210) {
        pulse = 1;
        lastBeat = now;
      }
      pulse *= .92;

      if (levelValue) levelValue.textContent = rounded(smoothLevel);
      if (lowValue) lowValue.textContent = rounded(smoothLow);
      if (midValue) midValue.textContent = rounded(smoothMid);
      if (highValue) highValue.textContent = rounded(smoothHigh);
      if (meterFill) meterFill.style.transform = `scaleX(${Math.min(1, smoothLevel * 1.35)})`;
      root?.style.setProperty('--energy', smoothLevel.toFixed(3));
      root?.style.setProperty('--low', smoothLow.toFixed(3));
      root?.style.setProperty('--mid', smoothMid.toFixed(3));
      root?.style.setProperty('--high', smoothHigh.toFixed(3));
      root?.style.setProperty('--pulse', pulse.toFixed(3));
    }

    function drawBackground() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const base = ctx.createRadialGradient(width * .5, height * .5, 0, width * .5, height * .5, Math.max(width, height) * .75);
      base.addColorStop(0, `rgba(13, 17, 33, ${.94 + smoothLevel * .04})`);
      base.addColorStop(.55, 'rgba(5, 8, 18, .98)');
      base.addColorStop(1, 'rgba(2, 3, 8, 1)');
      ctx.fillStyle = base;
      ctx.fillRect(0, 0, width, height);

      const glowRadius = Math.min(width, height) * (.23 + smoothLow * .16 + pulse * .045);
      const glow = ctx.createRadialGradient(width * .5, height * .54, 0, width * .5, height * .54, glowRadius);
      glow.addColorStop(0, `rgba(166, 205, 255, ${.14 + smoothLevel * .25})`);
      glow.addColorStop(.34, `rgba(117, 121, 255, ${.09 + smoothMid * .2})`);
      glow.addColorStop(.68, `rgba(163, 92, 255, ${.035 + smoothHigh * .13})`);
      glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);
    }

    function drawRibbons() {
      if (!ctx) return;
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      const layers = 5;

      for (let layer = 0; layer < layers; layer += 1) {
        const t = frame * (.0015 + layer * .00014);
        const centerY = height * (.42 + layer * .035);
        const amplitude = height * (.035 + smoothLow * .1 + layer * .007);
        const points = 90;
        const opacity = .025 + smoothLevel * .12 + layer * .006;

        ctx.beginPath();
        for (let i = 0; i <= points; i += 1) {
          const x = i / points * width;
          const normalized = i / points;
          const envelope = Math.sin(normalized * Math.PI);
          const wave = Math.sin(normalized * Math.PI * (2.1 + layer * .22) + t * (2.2 + layer * .15));
          const detail = Math.sin(normalized * Math.PI * 7 - t * 1.5 + layer) * (.18 + smoothHigh * .48);
          const y = centerY + (wave + detail) * amplitude * envelope;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        for (let i = points; i >= 0; i -= 1) {
          const x = i / points * width;
          const normalized = i / points;
          const envelope = Math.sin(normalized * Math.PI);
          const wave = Math.sin(normalized * Math.PI * (2.1 + layer * .22) + t * (2.2 + layer * .15) + .35);
          const y = centerY + wave * amplitude * envelope + 18 + smoothMid * 36 + layer * 6;
          ctx.lineTo(x, y);
        }
        ctx.closePath();

        const gradient = ctx.createLinearGradient(0, centerY, width, centerY);
        gradient.addColorStop(0, 'rgba(84, 139, 255, 0)');
        gradient.addColorStop(.2, `rgba(91, 179, 255, ${opacity})`);
        gradient.addColorStop(.5, `rgba(205, 188, 255, ${opacity * 1.45})`);
        gradient.addColorStop(.75, `rgba(153, 102, 255, ${opacity * 1.12})`);
        gradient.addColorStop(1, 'rgba(153, 102, 255, 0)');
        ctx.fillStyle = gradient;
        ctx.shadowBlur = 20 + smoothHigh * 45;
        ctx.shadowColor = 'rgba(132, 129, 255, .34)';
        ctx.fill();
      }
      ctx.restore();
    }

    function drawWaveform() {
      if (!ctx) return;
      const center = height * .53;
      const amplitude = Math.min(height * .18, 55 + smoothLevel * height * .17);
      const samples = timeData.length;
      const visualSamples = Math.min(260, samples);

      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.beginPath();
      for (let i = 0; i < visualSamples; i += 1) {
        const index = Math.floor(i / (visualSamples - 1) * (samples - 1));
        const sample = audio.analyser ? ((timeData[index] ?? 128) - 128) / 128 : Math.sin(frame * .006 + i * .09) * .025;
        const x = i / (visualSamples - 1) * width;
        const edge = Math.sin(i / (visualSamples - 1) * Math.PI);
        const y = center + sample * amplitude * edge;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgba(231, 240, 255, ${.18 + smoothLevel * .58})`;
      ctx.lineWidth = .7 + smoothHigh * 1.2;
      ctx.shadowBlur = 8 + smoothHigh * 18;
      ctx.shadowColor = 'rgba(164, 205, 255, .9)';
      ctx.stroke();
      ctx.restore();
    }

    function drawParticles() {
      if (!ctx) return;
      ctx.save();
      ctx.globalCompositeOperation = 'screen';

      particles.forEach((particle, index) => {
        const freqIndex = frequencyData.length ? Math.floor(index / particles.length * Math.min(frequencyData.length, 520)) : 0;
        const freq = audio.analyser ? (frequencyData[freqIndex] ?? 0) / 255 : 0;
        particle.angle += (.0006 + smoothHigh * .003) * particle.depth;
        particle.x += Math.cos(particle.angle + particle.phase) * particle.speed * (1 + smoothMid * 4);
        particle.y += Math.sin(particle.angle * .7 + particle.phase) * particle.speed * (1 + smoothLow * 2.5);
        if (particle.x < -.04) particle.x = 1.04;
        if (particle.x > 1.04) particle.x = -.04;
        if (particle.y < -.04) particle.y = 1.04;
        if (particle.y > 1.04) particle.y = -.04;

        const dx = particle.x - .5;
        const dy = particle.y - .52;
        const beatPush = pulse * .026 * particle.depth;
        const px = (particle.x + dx * beatPush) * width;
        const py = (particle.y + dy * beatPush) * height;
        const radius = particle.radius * (1 + freq * 2 + smoothHigh * 1.3);
        const alpha = .08 + particle.depth * .25 + freq * .34;

        ctx.beginPath();
        ctx.arc(px, py, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${184 + Math.floor(freq * 45)}, ${203 + Math.floor(freq * 35)}, 255, ${alpha})`;
        ctx.shadowBlur = 7 + freq * 17;
        ctx.shadowColor = 'rgba(155, 187, 255, .8)';
        ctx.fill();
      });
      ctx.restore();
    }

    function drawPulse() {
      if (!ctx || pulse < .025) return;
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      const progress = 1 - pulse;
      const radius = Math.min(width, height) * (.12 + progress * .54);
      ctx.beginPath();
      ctx.arc(width * .5, height * .53, radius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(186, 210, 255, ${pulse * .23})`;
      ctx.lineWidth = 1;
      ctx.shadowBlur = 18;
      ctx.shadowColor = 'rgba(134, 151, 255, .8)';
      ctx.stroke();
      ctx.restore();
    }

    function render() {
      if (!ctx) return;
      frame += 1;
      updateAnalysis();
      drawBackground();
      drawRibbons();
      drawParticles();
      drawWaveform();
      drawPulse();
      requestAnimationFrame(render);
    }

    async function getInputStream() {
      if (isMobile) {
        return navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: false,
            noiseSuppression: false,
            autoGainControl: false
          },
          video: false
        });
      }

      const stream = await navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false
        } as MediaTrackConstraints
      });

      const audioTracks = stream.getAudioTracks();
      if (!audioTracks.length) {
        stream.getTracks().forEach((track) => track.stop());
        throw new Error('NO_SYSTEM_AUDIO');
      }

      stream.getVideoTracks().forEach((track) => track.stop());
      return new MediaStream(audioTracks);
    }

    async function connectAudio() {
      if (running || !listenButton) return;
      listenButton.disabled = true;
      if (listenLabel) listenLabel.textContent = 'CONNECTING…';
      accessPanel?.classList.remove('error');

      try {
        if (!navigator.mediaDevices) throw new Error('UNSUPPORTED');
        const stream = await getInputStream();
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioContextClass) throw new Error('UNSUPPORTED');

        const context = new AudioContextClass();
        await context.resume();
        const analyser = context.createAnalyser();
        analyser.fftSize = 2048;
        analyser.smoothingTimeConstant = .78;
        analyser.minDecibels = -92;
        analyser.maxDecibels = -18;
        const source = context.createMediaStreamSource(stream);
        source.connect(analyser);

        audio.context = context;
        audio.analyser = analyser;
        audio.source = source;
        audio.stream = stream;
        frequencyData = new Uint8Array(analyser.frequencyBinCount);
        timeData = new Uint8Array(analyser.fftSize);
        running = true;

        root?.classList.add('is-listening');
        intro?.classList.add('is-hidden');
        if (topState) topState.textContent = 'LISTENING';
        if (activeHint) activeHint.textContent = isMobile ? '주변의 소리에 반응하고 있습니다.' : '시스템 오디오에 반응하고 있습니다.';

        const track = stream.getAudioTracks()[0];
        track?.addEventListener('ended', disconnectAudio, { once: true });
      } catch (error) {
        const code = error instanceof Error ? error.message : '';
        accessPanel?.classList.add('error');
        if (permissionTitle) permissionTitle.textContent = code === 'NO_SYSTEM_AUDIO' ? '오디오 공유가 선택되지 않았습니다.' : '입력을 연결하지 못했습니다.';
        if (permissionCopy) {
          permissionCopy.textContent = code === 'NO_SYSTEM_AUDIO'
            ? '다시 시도한 뒤 공유 창에서 시스템 또는 탭 오디오 공유 옵션을 켜 주세요.'
            : isMobile
              ? '브라우저 설정에서 마이크 권한을 허용한 뒤 다시 시도해 주세요.'
              : '이 브라우저가 시스템 오디오 공유를 지원하는지 확인한 뒤 다시 시도해 주세요.';
        }
        if (privacyNote) privacyNote.textContent = '권한은 언제든 브라우저에서 해제할 수 있습니다.';
        if (listenLabel) listenLabel.textContent = 'TRY AGAIN';
      } finally {
        listenButton.disabled = false;
      }
    }

    function disconnectAudio() {
      audio.stream?.getTracks().forEach((track) => track.stop());
      audio.source?.disconnect();
      audio.context?.close();
      audio.context = null;
      audio.analyser = null;
      audio.source = null;
      audio.stream = null;
      running = false;
      root?.classList.remove('is-listening');
      intro?.classList.remove('is-hidden');
      accessPanel?.classList.remove('error');
      if (topState) topState.textContent = 'DORMANT';
      setDeviceCopy();
      if (activeHint) activeHint.textContent = '소리를 재생하면 화면 전체가 반응합니다.';
    }

    setDeviceCopy();
    resize();
    window.addEventListener('resize', resize, { passive: true });
    listenButton?.addEventListener('click', connectAudio);
    disconnectButton?.addEventListener('click', disconnectAudio);
    if (!reducedMotion) render();
    else {
      drawBackground();
      drawRibbons();
      drawParticles();
      drawWaveform();
    }
  </script>

  <style>
    :global(html) { background: #020308; }
    :global(body.resonance-page) {
      margin: 0;
      background: #020308;
      color: #eef4ff;
      overflow: hidden;
    }
    :global(.resonance-page .theme-toggle) { display: none !important; }

    .resonance {
      --energy: 0;
      --low: 0;
      --mid: 0;
      --high: 0;
      --pulse: 0;
      position: relative;
      width: 100vw;
      min-height: 100dvh;
      overflow: hidden;
      isolation: isolate;
      background: #020308;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    #visualCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -4;
    }

    .grain {
      position: fixed;
      inset: -50%;
      z-index: -2;
      pointer-events: none;
      opacity: .095;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
      animation: grainShift .32s steps(2) infinite;
    }

    .vignette {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:

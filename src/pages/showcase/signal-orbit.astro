---
import BaseLayout from '@/layouts/BaseLayout.astro';
const nodes = [
  { label: 'Client', sub: 'request', class: 'n1' },
  { label: 'Edge', sub: 'route', class: 'n2' },
  { label: 'API', sub: 'compute', class: 'n3' },
  { label: 'Cache', sub: '2.1 ms', class: 'n4' },
  { label: 'DB', sub: 'persist', class: 'n5' }
];
---
<BaseLayout title="Signal Orbit — Static Atlas" description="분산 시스템의 요청 흐름을 궤도처럼 시각화한 정적 페이지 예시." className="orbit-page">
  <div class="noise" aria-hidden="true"></div>
  <header class="topbar shell">
    <a href="/" class="back">← Atlas</a>
    <span class="mark">SIGNAL / ORBIT</span>
    <span class="index">001</span>
  </header>

  <main>
    <section class="hero shell">
      <div class="copy">
        <p class="eyebrow">System design / request flow</p>
        <h1>Every request<br />leaves a <i>trace.</i></h1>
        <p class="intro">복잡한 시스템도 결국 하나의 신호가 이동하는 경로입니다. 클라이언트에서 데이터베이스까지, 요청이 지나가는 계층을 하나의 궤도로 압축했습니다.</p>
        <div class="stats">
          <div><strong>18.4</strong><span>ms p50</span></div>
          <div><strong>99.98</strong><span>% availability</span></div>
          <div><strong>4.7k</strong><span>req / sec</span></div>
        </div>
      </div>

      <div class="visual" aria-label="Stylized distributed system orbit diagram">
        <div class="halo h1"></div>
        <div class="halo h2"></div>
        <div class="halo h3"></div>
        <div class="core"><span>API</span><small>core</small></div>
        <div class="beam b1"></div><div class="beam b2"></div><div class="beam b3"></div>
        {nodes.map((node) => (
          <div class={`system-node ${node.class}`}>
            <span class="dot"></span>
            <strong>{node.label}</strong>
            <small>{node.sub}</small>
          </div>
        ))}
        <div class="pulse p1"></div><div class="pulse p2"></div><div class="pulse p3"></div>
      </div>
    </section>

    <section class="flow shell">
      <div class="section-label"><span>01</span> Signal path</div>
      <div class="steps">
        <article><span>01</span><h2>Enter</h2><p>Edge가 요청을 받아 가장 가까운 정상 리전에 연결합니다.</p><small>DNS · CDN · TLS</small></article>
        <article><span>02</span><h2>Resolve</h2><p>API 계층은 캐시와 영속 저장소 중 가장 저렴한 경로를 선택합니다.</p><small>Gateway · Cache</small></article>
        <article><span>03</span><h2>Persist</h2><p>필요한 변경만 데이터베이스에 기록하고 응답을 다시 궤도 밖으로 보냅니다.</p><small>PostgreSQL · Queue</small></article>
      </div>
    </section>

    <section class="quote shell">
      <p>“Architecture is invisible<br />until you <em>draw the motion.</em>”</p>
      <span>Static Atlas / 001</span>
    </section>
  </main>

  <footer class="shell footer"><a href="/">Back to collection</a><span>Built with zero client JavaScript</span></footer>
</BaseLayout>

<style>
:global(.orbit-page){background:#07090d;color:#f4f5f8;overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.045;z-index:20;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E")}.topbar{height:90px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid rgba(255,255,255,.09);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#8e94a0}.back{justify-self:start;color:#d3d5db}.mark{color:#fff;font-weight:700}.index{justify-self:end}.hero{min-height:760px;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:50px;padding-top:40px;padding-bottom:80px}.copy{position:relative;z-index:2}.copy h1{font-size:clamp(4.1rem,7.4vw,8.1rem);line-height:.82;letter-spacing:-.075em;margin:24px 0 36px;font-weight:720}.copy h1 i{font-family:Georgia,serif;font-weight:400;color:#baaaff}.intro{color:#a8adba;max-width:570px;line-height:1.85;font-size:1rem}.stats{display:flex;gap:42px;margin-top:58px;padding-top:26px;border-top:1px solid rgba(255,255,255,.1);max-width:580px}.stats div{display:flex;flex-direction:column}.stats strong{font-size:1.35rem;letter-spacing:-.03em}.stats span{text-transform:uppercase;color:#717784;font-size:.62rem;letter-spacing:.14em;margin-top:6px}.visual{position:relative;height:630px;min-width:560px}.halo{position:absolute;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);border:1px solid rgba(255,255,255,.1)}.h1{width:520px;height:520px;box-shadow:0 0 120px rgba(124,89,255,.08) inset}.h2{width:380px;height:380px;border-color:rgba(152,126,255,.25)}.h3{width:230px;height:230px;border-color:rgba(89,226,231,.23)}.core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:112px;height:112px;border-radius:50%;display:grid;place-content:center;text-align:center;background:radial-gradient(circle at 35% 30%,#d4c7ff,#7758e7 35%,#221d51 74%);box-shadow:0 0 80px rgba(126,95,255,.42),0 0 0 10px rgba(141,117,255,.05)}.core span{font-weight:900;font-size:1.15rem}.core small{font-size:.58rem;text-transform:uppercase;letter-spacing:.16em;opacity:.65;margin-top:3px}.system-node{position:absolute;display:grid;grid-template-columns:auto 1fr;column-gap:9px;align-items:center}.system-node .dot{grid-row:1/3;width:10px;height:10px;border-radius:50%;background:#fff;box-shadow:0 0 0 6px rgba(255,255,255,.05),0 0 24px rgba(147,125,255,.8)}.system-node strong{font-size:.74rem;letter-spacing:.02em}.system-node small{font-size:.58rem;color:#747a87;text-transform:uppercase;letter-spacing:.1em}.n1{left:4%;top:48%}.n2{left:17%;top:16%}.n3{right:4%;top:22%}.n4{right:3%;bottom:19%}.n5{left:24%;bottom:6%}.beam{position:absolute;left:50%;top:50%;height:1px;transform-origin:left center;background:linear-gradient(90deg,rgba(163,142,255,.7),transparent)}.b1{width:255px;transform:rotate(-38deg)}.b2{width:290px;transform:rotate(39deg)}.b3{width:245px;transform:rotate(137deg)}.pulse{position:absolute;width:7px;height:7px;border-radius:50%;background:#b9fff5;box-shadow:0 0 24px #62e7e4}.p1{left:68%;top:31%}.p2{right:19%;bottom:28%}.p3{left:23%;top:49%}.flow{padding-top:85px;padding-bottom:125px;border-top:1px solid rgba(255,255,255,.1)}.section-label{display:flex;gap:20px;align-items:center;color:#787f8d;text-transform:uppercase;letter-spacing:.15em;font-size:.66rem}.section-label span{color:#bcaeff}.steps{display:grid;grid-template-columns:repeat(3,1fr);margin-top:42px;border-top:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1)}.steps article{padding:34px 34px 38px 0;min-height:270px;border-right:1px solid rgba(255,255,255,.1)}.steps article+article{padding-left:34px}.steps article:last-child{border-right:0}.steps article>span{color:#71668f;font-size:.67rem}.steps h2{font-size:2rem;letter-spacing:-.05em;margin:36px 0 16px}.steps p{color:#999fac;line-height:1.75;margin:0;max-width:300px}.steps small{display:block;margin-top:28px;color:#b7a8ff;text-transform:uppercase;letter-spacing:.12em;font-size:.59rem}.quote{padding:120px 0 140px;display:flex;justify-content:space-between;align-items:flex-end}.quote p{margin:0;font-size:clamp(3.5rem,6vw,6.8rem);line-height:.94;letter-spacing:-.065em}.quote em{font-family:Georgia,serif;font-weight:400;color:#7be5df}.quote span{color:#6f7582;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}.footer{height:90px;border-top:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:space-between;color:#777d89;text-transform:uppercase;font-size:.62rem;letter-spacing:.13em}.footer a{color:#cccfd7}@media(max-width:980px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:80px}.visual{min-width:0;height:560px}.copy h1{font-size:clamp(4.4rem,13vw,7rem)}.steps{grid-template-columns:1fr}.steps article,.steps article+article{padding:28px 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.1);min-height:0}.steps article:last-child{border-bottom:0}.quote{flex-direction:column;align-items:flex-start;gap:44px}}@media(max-width:620px){.topbar{grid-template-columns:1fr 1fr}.mark{display:none}.visual{height:430px;transform:scale(.78);margin:-30px -12%}.stats{gap:18px;justify-content:space-between}.stats strong{font-size:1.08rem}.quote{padding-top:80px}.footer{align-items:flex-start;justify-content:center;flex-direction:column;gap:8px}}
</style>

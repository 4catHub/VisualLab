---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Signal Orbit — VisualLab" description="Animated request-flow visualizer for a distributed system." className="signal-page">
  <main class="scene">
    <header class="topbar shell">
      <a href="/" class="back">← VisualLab</a>
      <span class="label">SIGNAL ORBIT / 001</span>
      <span class="status" id="statusText">READY</span>
    </header>

    <section class="hero shell">
      <div class="copy">
        <p class="eyebrow">Distributed request flow</p>
        <h1>Watch a request<br />move through<br /><em>the system.</em></h1>
        <p class="description">
          하나의 요청이 들어와 라우팅되고, 캐시를 확인하고, 필요하면 데이터베이스까지 도달한 뒤 응답으로 되돌아가는 흐름을 재생합니다.
        </p>
        <button id="replayButton" type="button">Replay request</button>
      </div>

      <div class="visualizer" id="visualizer" aria-label="Animated distributed system request flow">
        <svg class="network" viewBox="0 0 900 620" role="img" aria-hidden="true">
          <defs>
            <filter id="glow">
              <feGaussianBlur stdDeviation="7" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <path id="p-client-edge" class="route" d="M130 310 C210 310 235 205 320 205" />
          <path id="p-edge-api" class="route" d="M370 205 C455 205 455 310 535 310" />
          <path id="p-api-cache" class="route" d="M585 310 C665 310 670 205 750 205" />
          <path id="p-api-db" class="route" d="M585 310 C670 310 665 425 750 425" />
          <path id="p-cache-api" class="route return" d="M750 235 C670 235 665 340 585 340" />
          <path id="p-db-api" class="route return" d="M750 455 C665 455 670 340 585 340" />
          <path id="p-api-edge" class="route return" d="M535 340 C455 340 455 235 370 235" />
          <path id="p-edge-client" class="route return" d="M320 235 C235 235 210 340 130 340" />
        </svg>

        <div class="node client" data-node="client"><span>Client</span><small>origin</small></div>
        <div class="node edge" data-node="edge"><span>Edge</span><small>route</small></div>
        <div class="node api" data-node="api"><span>API</span><small>compute</small></div>
        <div class="node cache" data-node="cache"><span>Cache</span><small>lookup</small></div>
        <div class="node db" data-node="db"><span>DB</span><small>persist</small></div>

        <div class="packet" id="packet"><span>REQ</span></div>
        <div class="trace-log" aria-live="polite">
          <span id="stepIndex">00</span>
          <p id="traceText">Awaiting request</p>
        </div>
      </div>
    </section>

    <section class="metrics shell">
      <article><span>Path</span><strong id="pathMetric">—</strong></article>
      <article><span>Latency</span><strong id="latencyMetric">—</strong></article>
      <article><span>Result</span><strong id="resultMetric">Idle</strong></article>
    </section>
  </main>

  <script>
    const packet = document.querySelector('#packet');
    const replayButton = document.querySelector('#replayButton');
    const statusText = document.querySelector('#statusText');
    const traceText = document.querySelector('#traceText');
    const stepIndex = document.querySelector('#stepIndex');
    const pathMetric = document.querySelector('#pathMetric');
    const latencyMetric = document.querySelector('#latencyMetric');
    const resultMetric = document.querySelector('#resultMetric');
    const visualizer = document.querySelector('#visualizer');

    const nodePositions = {
      client: [14.5, 50],
      edge: [38.3, 33],
      api: [62.2, 50],
      cache: [86, 33],
      db: [86, 69]
    };

    const state = { run: 0, busy: false };

    function wait(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function setNode(name, mode = '') {
      document.querySelectorAll('.node').forEach((node) => node.classList.remove('active', 'done'));
      const target = document.querySelector(`[data-node="${name}"]`);
      if (target && mode) target.classList.add(mode);
    }

    function markDone(name) {
      const target = document.querySelector(`[data-node="${name}"]`);
      target?.classList.remove('active');
      target?.classList.add('done');
    }

    function setPacketPosition(name) {
      const pos = nodePositions[name];
      if (!packet || !pos) return;
      packet.style.left = `${pos[0]}%`;
      packet.style.top = `${pos[1]}%`;
    }

    async function move(from, to, label, index, duration = 760) {
      const target = document.querySelector(`[data-node="${to}"]`);
      const routeId = `#p-${from}-${to}`;
      const route = document.querySelector(routeId);
      stepIndex.textContent = String(index).padStart(2, '0');
      traceText.textContent = label;
      document.querySelectorAll('.node').forEach((node) => node.classList.remove('active'));
      target?.classList.add('active');
      route?.classList.add('hot');
      packet?.classList.add('moving');
      setPacketPosition(to);
      await wait(duration);
      route?.classList.remove('hot');
      packet?.classList.remove('moving');
      markDone(to);
    }

    async function runFlow() {
      if (state.busy) return;
      state.busy = true;
      state.run += 1;
      const cacheHit = state.run % 2 === 1;

      document.querySelectorAll('.node').forEach((node) => node.classList.remove('active', 'done'));
      document.querySelectorAll('.route').forEach((route) => route.classList.remove('hot'));
      visualizer?.classList.remove('complete');
      replayButton.disabled = true;
      statusText.textContent = 'IN FLIGHT';
      resultMetric.textContent = 'Processing';
      pathMetric.textContent = cacheHit ? 'Cache path' : 'DB path';
      latencyMetric.textContent = cacheHit ? '12.8 ms' : '31.4 ms';
      packet.querySelector('span').textContent = 'REQ';
      packet.classList.remove('response');
      setPacketPosition('client');
      setNode('client', 'active');
      stepIndex.textContent = '01';
      traceText.textContent = 'Request created at client';
      await wait(650);
      markDone('client');

      await move('client', 'edge', 'Routing through nearest edge', 2);
      await move('edge', 'api', 'API receives and evaluates request', 3);

      if (cacheHit) {
        await move('api', 'cache', 'Checking cache for existing value', 4);
        traceText.textContent = 'Cache hit — skipping database';
        resultMetric.textContent = 'Cache hit';
        await wait(650);
        packet.querySelector('span').textContent = 'RES';
        packet.classList.add('response');
        await move('cache', 'api', 'Returning cached value to API', 5);
      } else {
        await move('api', 'cache', 'Checking cache for existing value', 4);
        traceText.textContent = 'Cache miss — database required';
        resultMetric.textContent = 'Cache miss';
        await wait(650);
        await move('api', 'db', 'Reading persistent data from database', 5, 900);
        packet.querySelector('span').textContent = 'RES';
        packet.classList.add('response');
        await move('db', 'api', 'Database result returns to API', 6, 900);
      }

      const base = cacheHit ? 6 : 7;
      await move('api', 'edge', 'Response passes back through edge', base);
      await move('edge', 'client', 'Response delivered to client', base + 1);

      statusText.textContent = 'COMPLETE';
      traceText.textContent = cacheHit ? 'Request complete — cache path' : 'Request complete — database path';
      resultMetric.textContent = '200 OK';
      visualizer?.classList.add('complete');
      replayButton.disabled = false;
      state.busy = false;
    }

    replayButton?.addEventListener('click', runFlow);
    window.addEventListener('load', () => setTimeout(runFlow, 700));
  </script>
</BaseLayout>

<style>
  :global(.signal-page) {
    background:
      radial-gradient(circle at 68% 42%, rgba(92, 82, 255, .11), transparent 33%),
      #06080c;
    color: #f5f7fb;
    overflow-x: hidden;
  }

  .scene { min-height: 100vh; }

  .topbar {
    height: 86px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,.09);
    color: #767d89;
    font-size: .64rem;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .back { color: #d7dae1; justify-self: start; }
  .label { color: #9ca2ad; }
  .status { justify-self: end; color: #7ce7df; }

  .hero {
    min-height: 710px;
    display: grid;
    grid-template-columns: .72fr 1.28fr;
    gap: clamp(28px, 4vw, 70px);
    align-items: center;
    padding-top: 48px;
    padding-bottom: 62px;
  }

  .copy { position: relative; z-index: 3; }
  .copy h1 {
    margin: 22px 0 30px;
    font-size: clamp(3.9rem, 6.3vw, 7rem);
    line-height: .86;
    letter-spacing: -.074em;
    font-weight: 730;
  }

  .copy h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: #b7a8ff;
  }

  .description {
    max-width: 500px;
    margin: 0;
    color: #989fab;
    line-height: 1.8;
  }

  button {
    margin-top: 36px;
    padding: 13px 18px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 999px;
    background: rgba(255,255,255,.045);
    color: white;
    cursor: pointer;
    transition: .2s ease;
  }

  button:hover:not(:disabled) { background: rgba(255,255,255,.09); transform: translateY(-1px); }
  button:disabled { opacity: .42; cursor: default; }

  .visualizer {
    position: relative;
    min-height: 620px;
    border: 1px solid rgba(255,255,255,.085);
    border-radius: 34px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px),
      radial-gradient(circle at 62% 50%, rgba(123,95,255,.08), transparent 42%);
    background-size: 42px 42px, 42px 42px, auto;
  }

  .visualizer::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 100px rgba(0,0,0,.55);
  }

  .network { position: absolute; inset: 0; width: 100%; height: 100%; }

  .route {
    fill: none;
    stroke: rgba(255,255,255,.09);
    stroke-width: 2;
    stroke-linecap: round;
    transition: stroke .2s ease, filter .2s ease;
  }

  .route.return { stroke-dasharray: 5 9; }
  .route.hot {
    stroke: #8bece5;
    filter: url(#glow);
    stroke-dasharray: 12 10;
    animation: dash .45s linear infinite;
  }

  @keyframes dash { to { stroke-dashoffset: -22; } }

  .node {
    position: absolute;
    width: 92px;
    height: 92px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 24px;
    display: grid;
    place-content: center;
    text-align: center;
    background: rgba(9,12,18,.86);
    backdrop-filter: blur(12px);
    z-index: 2;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease, background .25s ease;
  }

  .node span { font-size: .82rem; font-weight: 750; }
  .node small { margin-top: 5px; color: #6f7682; font-size: .55rem; letter-spacing: .11em; text-transform: uppercase; }
  .node.active {
    border-color: rgba(126,233,226,.9);
    background: rgba(23,48,51,.82);
    box-shadow: 0 0 0 7px rgba(102,232,224,.05), 0 0 44px rgba(91,230,221,.25);
    transform: translate(-50%, -50%) scale(1.07);
  }
  .node.done { border-color: rgba(178,161,255,.42); }
  .node.done::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    right: 10px;
    top: 10px;
    border-radius: 50%;
    background: #a995ff;
    box-shadow: 0 0 14px #a995ff;
  }

  .client { left: 14.5%; top: 50%; }
  .edge { left: 38.3%; top: 33%; }
  .api { left: 62.2%; top: 50%; width: 108px; height: 108px; border-radius: 50%; }
  .cache { left: 86%; top: 33%; }
  .db { left: 86%; top: 69%; }

  .packet {
    position: absolute;
    left: 14.5%;
    top: 50%;
    width: 38px;
    height: 38px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
    z-index: 5;
    background: #8bece5;
    color: #06100f;
    box-shadow: 0 0 30px rgba(105,238,228,.7);
    transition: left .76s cubic-bezier(.65,.05,.36,1), top .76s cubic-bezier(.65,.05,.36,1), background .25s ease, box-shadow .25s ease;
  }

  .packet span { font-size: .47rem; font-weight: 900; letter-spacing: .04em; }
  .packet.moving { box-shadow: 0 0 50px rgba(105,238,228,.95); }
  .packet.response { background: #b39cff; color: #0d0820; box-shadow: 0 0 34px rgba(179,156,255,.75); }

  .trace-log {
    position: absolute;
    left: 28px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 3;
  }

  .trace-log span {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50%;
    color: #8c82c2;
    font-size: .57rem;
  }

  .trace-log p { margin: 0; color: #a9afba; font-size: .72rem; }
  .complete .trace-log p { color: #d7d2ff; }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255,255,255,.1);
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .metrics article {
    min-height: 126px;
    padding: 28px 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(255,255,255,.1);
  }
  .metrics article + article { padding-left: 32px; }
  .metrics article:last-child { border-right: 0; }
  .metrics span { color: #676e7b; font-size: .6rem; text-transform: uppercase; letter-spacing: .14em; }
  .metrics strong { font-size: 1.35rem; letter-spacing: -.04em; }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; }
    .visualizer { min-height: 560px; }
  }

  @media (max-width: 640px) {
    .topbar { grid-template-columns: 1fr 1fr; }
    .label { display: none; }
    .copy h1 { font-size: clamp(3.6rem, 16vw, 5.5rem); }
    .visualizer { min-height: 450px; border-radius: 24px; }
    .node { width: 68px; height: 68px; border-radius: 18px; }
    .api { width: 78px; height: 78px; }
    .node span { font-size: .68rem; }
    .node small { font-size: .45rem; }
    .packet { width: 30px; height: 30px; }
    .trace-log { left: 16px; bottom: 15px; max-width: 78%; }
    .trace-log p { font-size: .62rem; }
    .metrics { grid-template-columns: 1fr; }
    .metrics article, .metrics article + article { padding: 22px 0; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.1); min-height: 94px; }
    .metrics article:last-child { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .packet, .node, .route { transition-duration: .01ms !important; animation: none !important; }
  }
</style>

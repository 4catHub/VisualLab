---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Gravity Field — VisualLab"
  description="A pointer-reactive particle field that bends space, type, and light in real time."
  className="gravity-page"
>
  <main>
    <canvas id="gravityCanvas" class="field" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <header class="topbar shell">
      <a href="/" class="back">← VisualLab</a>
      <span class="label">GRAVITY FIELD / 002</span>
      <button class="mode" id="modeButton" type="button" aria-label="Toggle gravity polarity">
        <span class="mode-dot"></span>
        <span id="modeText">ATTRACT</span>
      </button>
    </header>

    <section class="hero shell" aria-labelledby="gravity-title">
      <div class="hero-meta left-meta" aria-hidden="true">
        <span>Interactive field</span>
        <span>Move cursor</span>
      </div>

      <div class="title-wrap" id="titleWrap">
        <p class="eyebrow">Pointer-reactive space</p>
        <h1 id="gravity-title">
          <span class="line line-a" data-shift="-1">BEND</span>
          <span class="line line-b" data-shift="1">THE</span>
          <span class="line line-c" data-shift="-0.6">FIELD.</span>
        </h1>
        <p class="lede">
          커서를 움직이면 보이지 않던 장력이 드러납니다. 클릭하면 중력이 반전되고, 입자와 타이포그래피가 같은 힘에 반응합니다.
        </p>
      </div>

      <div class="meter" aria-live="polite">
        <div><span>X</span><strong id="xValue">0.50</strong></div>
        <div><span>Y</span><strong id="yValue">0.50</strong></div>
        <div><span>FORCE</span><strong id="forceValue">+1.00</strong></div>
      </div>

      <a class="scroll-cue" href="#afterglow">
        <span>Scroll to fracture</span>
        <i aria-hidden="true"></i>
      </a>
    </section>

    <section class="marquee" id="afterglow" aria-label="Motion phrase">
      <div class="marquee-track" id="marqueeTrack">
        <span>MOVE</span><b>·</b><span>DISTORT</span><b>·</b><span>REFORM</span><b>·</b>
        <span>MOVE</span><b>·</b><span>DISTORT</span><b>·</b><span>REFORM</span><b>·</b>
      </div>
    </section>

    <section class="principles shell">
      <div class="section-head">
        <p class="eyebrow">Three states</p>
        <h2>One field.<br />Three reactions.</h2>
        <p>같은 입력도 시각적 규칙을 바꾸면 전혀 다른 감각으로 읽힙니다.</p>
      </div>

      <div class="cards">
        <article class="card card-push">
          <span class="card-index">01</span>
          <div class="card-art push-art" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <div class="card-copy">
            <h3>Pull</h3>
            <p>가까운 점일수록 더 빠르게 중심으로 휘어집니다.</p>
          </div>
        </article>

        <article class="card card-bend">
          <span class="card-index">02</span>
          <div class="card-art bend-art" aria-hidden="true">
            <span>FIELD</span><span>FIELD</span><span>FIELD</span>
          </div>
          <div class="card-copy">
            <h3>Bend</h3>
            <p>타이포그래피도 같은 포인터 벡터를 공유합니다.</p>
          </div>
        </article>

        <article class="card card-release">
          <span class="card-index">03</span>
          <div class="card-art release-art" aria-hidden="true">
            <span class="ring r1"></span>
            <span class="ring r2"></span>
            <span class="ring r3"></span>
            <span class="core"></span>
          </div>
          <div class="card-copy">
            <h3>Release</h3>
            <p>클릭 한 번으로 극성을 뒤집어 장면 전체를 밀어냅니다.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="finale">
      <div class="finale-glow" aria-hidden="true"></div>
      <div class="shell finale-inner">
        <p class="eyebrow">Live interaction</p>
        <h2>Nothing is<br />standing still.</h2>
        <button class="return-button" id="resetButton" type="button">Reset the field <span>↺</span></button>
      </div>
    </section>
  </main>

  <script>
    type Particle = {
      baseX: number;
      baseY: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      color: [number, number, number];
    };

    const canvas = document.querySelector<HTMLCanvasElement>('#gravityCanvas');
    const ctx = canvas?.getContext('2d');
    const titleWrap = document.querySelector<HTMLElement>('#titleWrap');
    const titleLines = document.querySelectorAll<HTMLElement>('[data-shift]');
    const xValue = document.querySelector<HTMLElement>('#xValue');
    const yValue = document.querySelector<HTMLElement>('#yValue');
    const forceValue = document.querySelector<HTMLElement>('#forceValue');
    const modeButton = document.querySelector<HTMLButtonElement>('#modeButton');
    const modeText = document.querySelector<HTMLElement>('#modeText');
    const resetButton = document.querySelector<HTMLButtonElement>('#resetButton');
    const marqueeTrack = document.querySelector<HTMLElement>('#marqueeTrack');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const state = {
      width: 0,
      height: 0,
      dpr: Math.min(window.devicePixelRatio || 1, 2),
      pointer: { x: window.innerWidth * 0.5, y: window.innerHeight * 0.46, tx: window.innerWidth * 0.5, ty: window.innerHeight * 0.46 },
      polarity: 1,
      particles: [] as Particle[]
    };

    const palette: [number, number, number][] = [
      [148, 118, 255],
      [95, 232, 226],
      [255, 117, 82]
    ];

    function buildParticles() {
      if (!canvas || !ctx) return;
      const gap = state.width < 720 ? 34 : 29;
      const cols = Math.ceil(state.width / gap) + 2;
      const rows = Math.ceil(state.height / gap) + 2;
      const particles: Particle[] = [];
      for (let y = -1; y < rows; y += 1) {
        for (let x = -1; x < cols; x += 1) {
          const baseX = x * gap + (y % 2) * gap * 0.5;
          const baseY = y * gap;
          const color = palette[Math.abs(x + y) % palette.length] ?? palette[0];
          particles.push({ baseX, baseY, x: baseX, y: baseY, vx: 0, vy: 0, size: 0.8 + ((x * 13 + y * 7) % 5 + 5) % 5 * 0.12, color });
        }
      }
      state.particles = particles;
    }

    function resize() {
      if (!canvas || !ctx) return;
      state.width = window.innerWidth;
      state.height = window.innerHeight;
      canvas.width = Math.floor(state.width * state.dpr);
      canvas.height = Math.floor(state.height * state.dpr);
      canvas.style.width = `${state.width}px`;
      canvas.style.height = `${state.height}px`;
      ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
      buildParticles();
    }

    function updateReadout() {
      const nx = Math.max(0, Math.min(1, state.pointer.tx / Math.max(state.width, 1)));
      const ny = Math.max(0, Math.min(1, state.pointer.ty / Math.max(state.height, 1)));
      if (xValue) xValue.textContent = nx.toFixed(2);
      if (yValue) yValue.textContent = ny.toFixed(2);
      if (forceValue) forceValue.textContent = state.polarity > 0 ? '+1.00' : '−1.00';
    }

    function updateType() {
      const nx = (state.pointer.x / Math.max(state.width, 1) - 0.5) * 2;
      const ny = (state.pointer.y / Math.max(state.height, 1) - 0.5) * 2;
      titleLines.forEach((line) => {
        const shift = Number(line.getAttribute('data-shift') || 0);
        line.style.transform = `translate3d(${nx * 20 * shift}px, ${ny * 10 * shift}px, 0)`;
      });
      if (titleWrap) {
        titleWrap.style.setProperty('--mx', `${50 + nx * 18}%`);
        titleWrap.style.setProperty('--my', `${50 + ny * 16}%`);
      }
    }

    function draw() {
      if (!ctx) return;
      state.pointer.x += (state.pointer.tx - state.pointer.x) * 0.085;
      state.pointer.y += (state.pointer.ty - state.pointer.y) * 0.085;
      ctx.clearRect(0, 0, state.width, state.height);
      const radius = Math.min(state.width, state.height) * 0.34;
      const radiusSq = radius * radius;

      for (const p of state.particles) {
        const dx = state.pointer.x - p.baseX;
        const dy = state.pointer.y - p.baseY;
        const distSq = dx * dx + dy * dy;
        const dist = Math.sqrt(distSq) || 1;
        let force = 0;
        if (distSq < radiusSq) {
          const influence = 1 - dist / radius;
          force = influence * influence * 30 * state.polarity;
        }
        const targetX = p.baseX + (dx / dist) * force;
        const targetY = p.baseY + (dy / dist) * force;
        p.vx += (targetX - p.x) * 0.055;
        p.vy += (targetY - p.y) * 0.055;
        p.vx *= 0.78;
        p.vy *= 0.78;
        p.x += p.vx;
        p.y += p.vy;

        const closeness = Math.max(0, 1 - dist / radius);
        const [r, g, b] = p.color;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${0.18 + closeness * 0.7})`;
        ctx.arc(p.x, p.y, p.size + closeness * 1.6, 0, Math.PI * 2);
        ctx.fill();
        if (closeness > 0.63 && !reducedMotion) {
          ctx.beginPath();
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${(closeness - 0.63) * 0.22})`;
          ctx.lineWidth = 0.5;
          ctx.moveTo(p.baseX, p.baseY);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
        }
      }
      updateType();
      if (!reducedMotion) requestAnimationFrame(draw);
    }

    function setPointer(clientX: number, clientY: number) {
      state.pointer.tx = clientX;
      state.pointer.ty = clientY;
      updateReadout();
      if (reducedMotion) {
        state.pointer.x = clientX;
        state.pointer.y = clientY;
        draw();
      }
    }

    function togglePolarity() {
      state.polarity *= -1;
      document.body.classList.toggle('is-repel', state.polarity < 0);
      if (modeText) modeText.textContent = state.polarity > 0 ? 'ATTRACT' : 'REPEL';
      updateReadout();
    }

    function resetField() {
      state.polarity = 1;
      document.body.classList.remove('is-repel');
      if (modeText) modeText.textContent = 'ATTRACT';
      setPointer(state.width * 0.5, state.height * 0.46);
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    }

    window.addEventListener('pointermove', (event) => setPointer(event.clientX, event.clientY), { passive: true });
    window.addEventListener('touchmove', (event) => {
      const touch = event.touches[0];
      if (touch) setPointer(touch.clientX, touch.clientY);
    }, { passive: true });
    window.addEventListener('resize', resize);
    window.addEventListener('scroll', () => {
      if (!marqueeTrack) return;
      marqueeTrack.style.transform = `translate3d(${-12 - window.scrollY * 0.13}px, 0, 0)`;
    }, { passive: true });
    modeButton?.addEventListener('click', togglePolarity);
    resetButton?.addEventListener('click', resetField);

    resize();
    updateReadout();
    if (reducedMotion) draw();
    else requestAnimationFrame(draw);
  </script>
</BaseLayout>

<style>
  :global(.gravity-page) {
    --violet: #9a7cff;
    --cyan: #63eee4;
    --coral: #ff765a;
    --ink: #06070a;
    background: var(--ink);
    color: #f6f5f2;
    overflow-x: hidden;
  }
  :global(.gravity-page.is-repel) { --violet: #ff765a; --coral: #9a7cff; }
  main { position: relative; isolation: isolate; }
  .field { position: fixed; inset: 0; z-index: -3; pointer-events: none; opacity: .9; mask-image: linear-gradient(to bottom, #000 0%, #000 74%, transparent 100%); }
  .grain { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .08; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; }
  .topbar { height: 84px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid rgba(255,255,255,.1); color: #8c909a; font-size: .62rem; font-weight: 650; letter-spacing: .16em; text-transform: uppercase; position: relative; z-index: 5; }
  .back { justify-self: start; color: #d9d9dc; transition: color .2s ease; }
  .back:hover { color: white; }
  .label { justify-self: center; }
  .mode { justify-self: end; border: 0; padding: 10px 0 10px 14px; display: flex; align-items: center; gap: 8px; background: transparent; color: #d8dade; font: inherit; letter-spacing: inherit; cursor: pointer; }
  .mode-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 14px var(--cyan); transition: background .25s ease, box-shadow .25s ease; }
  :global(.is-repel) .mode-dot { background: var(--coral); box-shadow: 0 0 14px var(--coral); }
  .hero { min-height: calc(100svh - 84px); position: relative; display: grid; place-items: center; padding-top: 64px; padding-bottom: 90px; }
  .hero::before { content: ''; position: absolute; width: min(65vw, 900px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(151, 118, 255, .10), rgba(99, 238, 228, .02) 42%, transparent 70%); filter: blur(10px); pointer-events: none; z-index: -1; }
  .title-wrap { --mx: 50%; --my: 50%; width: min(100%, 980px); text-align: center; position: relative; }
  .title-wrap::before { content: ''; position: absolute; inset: 13% 12%; background: radial-gradient(circle at var(--mx) var(--my), rgba(99, 238, 228, .18), transparent 28%), radial-gradient(circle at calc(100% - var(--mx)) calc(100% - var(--my)), rgba(154, 124, 255, .18), transparent 30%); filter: blur(45px); z-index: -1; opacity: .75; }
  .title-wrap .eyebrow { margin: 0 0 24px; }
  h1 { margin: 0; display: flex; flex-direction: column; align-items: center; font-size: clamp(5rem, 14vw, 11.4rem); line-height: .7; letter-spacing: -.095em; font-weight: 850; text-transform: uppercase; }
  .line { display: block; will-change: transform; transition: color .5s ease; }
  .line-a { color: #f7f6f2; }
  .line-b { color: transparent; -webkit-text-stroke: 1.4px rgba(255,255,255,.55); letter-spacing: -.06em; }
  .line-c { background: linear-gradient(92deg, var(--violet) 4%, #f4f0ff 42%, var(--cyan) 72%, var(--coral)); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 44px rgba(154, 124, 255, .12); }
  .lede { width: min(100%, 510px); margin: 42px auto 0; color: #9ea1aa; font-size: .92rem; line-height: 1.85; word-break: keep-all; }
  .hero-meta { position: absolute; top: 50%; display: flex; flex-direction: column; gap: 6px; color: #6e727c; font-size: .58rem; letter-spacing: .15em; text-transform: uppercase; writing-mode: vertical-rl; }
  .left-meta { left: 0; transform: translateY(-50%) rotate(180deg); }
  .meter { position: absolute; right: 0; top: 50%; width: 112px; transform: translateY(-50%); border: 1px solid rgba(255,255,255,.1); background: rgba(8,9,12,.38); backdrop-filter: blur(14px); }
  .meter div { min-height: 54px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: center; gap: 4px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .meter div:last-child { border-bottom: 0; }
  .meter span { color: #646974; font-size: .5rem; letter-spacing: .14em; }
  .meter strong { color: #d8dbe1; font-size: .73rem; font-weight: 550; font-variant-numeric: tabular-nums; }
  .scroll-cue { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; color: #747984; font-size: .54rem; letter-spacing: .15em; text-transform: uppercase; }
  .scroll-cue i { width: 1px; height: 34px; background: linear-gradient(to bottom, rgba(255,255,255,.6), transparent); animation: cue 1.8s ease-in-out infinite; }
  .marquee { height: clamp(150px, 20vw, 230px); overflow: hidden; display: flex; align-items: center; border-top: 1px solid rgba(255,255,255,.1); border-bottom: 1px solid rgba(255,255,255,.1); background: rgba(4,5,8,.72); backdrop-filter: blur(12px); }
  .marquee-track { width: max-content; display: flex; align-items: center; gap: clamp(24px, 4vw, 70px); white-space: nowrap; will-change: transform; font-size: clamp(4.2rem, 10vw, 9rem); font-weight: 850; line-height: 1; letter-spacing: -.07em; }
  .marquee-track span:nth-of-type(3n + 1) { color: #f1f1ee; }
  .marquee-track span:nth-of-type(3n + 2) { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.45); }
  .marquee-track span:nth-of-type(3n) { color: var(--violet); }
  .marquee-track b { color: var(--cyan); font-weight: 400; }
  .principles { padding-top: clamp(110px, 16vw, 190px); padding-bottom: clamp(120px, 18vw, 220px); }
  .section-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 30px 70px; margin-bottom: 72px; }
  .section-head .eyebrow { grid-column: 1 / -1; margin: 0; }
  .section-head h2, .finale h2 { margin: 0; font-size: clamp(3.4rem, 7vw, 6.8rem); line-height: .86; letter-spacing: -.07em; font-weight: 760; }
  .section-head > p:last-child { align-self: end; max-width: 400px; margin: 0; color: #8e929c; line-height: 1.8; word-break: keep-all; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.11); border-left: 1px solid rgba(255,255,255,.11); }
  .card { min-height: 510px; padding: 20px; display: flex; flex-direction: column; border-right: 1px solid rgba(255,255,255,.11); border-bottom: 1px solid rgba(255,255,255,.11); background: rgba(6,7,10,.48); backdrop-filter: blur(12px); overflow: hidden; transition: background .35s ease, transform .35s ease; }
  .card:hover { background: rgba(255,255,255,.035); transform: translateY(-4px); }
  .card-index { color: #636874; font-size: .58rem; letter-spacing: .15em; }
  .card-art { position: relative; flex: 1; min-height: 300px; display: grid; place-items: center; }
  .card-copy { border-top: 1px solid rgba(255,255,255,.1); padding-top: 20px; }
  .card-copy h3 { margin: 0 0 10px; font-size: 1.8rem; letter-spacing: -.04em; }
  .card-copy p { margin: 0; color: #858a95; font-size: .82rem; line-height: 1.7; word-break: keep-all; }
  .push-art i { position: absolute; left: 50%; top: 50%; width: 2px; height: 2px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 18px var(--cyan); }
  .push-art i:nth-child(1) { transform: translate(-100px,-70px); }
  .push-art i:nth-child(2) { transform: translate(82px,-90px); width: 5px; height: 5px; }
  .push-art i:nth-child(3) { transform: translate(-72px,65px); width: 4px; height: 4px; background: var(--violet); }
  .push-art i:nth-child(4) { transform: translate(95px,62px); }
  .push-art i:nth-child(5) { transform: translate(-20px,-8px); width: 8px; height: 8px; background: #fff; }
  .push-art i:nth-child(6) { transform: translate(32px,22px); width: 3px; height: 3px; background: var(--coral); }
  .push-art::before, .push-art::after { content: ''; position: absolute; width: 170px; height: 170px; border: 1px solid rgba(99,238,228,.16); border-radius: 50%; }
  .push-art::after { width: 245px; height: 245px; border-color: rgba(154,124,255,.12); }
  .card:hover .push-art::before { animation: pulse 1.8s ease-out infinite; }
  .bend-art { perspective: 500px; }
  .bend-art span { position: absolute; font-size: clamp(2.8rem, 5vw, 4.8rem); font-weight: 850; letter-spacing: -.08em; transition: transform .45s cubic-bezier(.16,1,.3,1); }
  .bend-art span:nth-child(1) { color: var(--coral); transform: translateY(-46px) skewX(-8deg) rotate(-4deg); }
  .bend-art span:nth-child(2) { color: #f5f4f1; transform: scaleX(.78); }
  .bend-art span:nth-child(3) { color: transparent; -webkit-text-stroke: 1px var(--violet); transform: translateY(46px) skewX(8deg) rotate(4deg); }
  .card:hover .bend-art span:nth-child(1) { transform: translate(-22px,-58px) skewX(-16deg) rotate(-8deg); }
  .card:hover .bend-art span:nth-child(2) { transform: scaleX(1.05); }
  .card:hover .bend-art span:nth-child(3) { transform: translate(22px,58px) skewX(16deg) rotate(8deg); }
  .release-art .ring { position: absolute; border: 1px solid rgba(255,255,255,.17); border-radius: 50%; transition: transform .6s cubic-bezier(.16,1,.3,1), border-color .3s ease; }
  .r1 { width: 82px; height: 82px; }
  .r2 { width: 154px; height: 154px; }
  .r3 { width: 230px; height: 230px; }
  .core { width: 16px; height: 16px; border-radius: 50%; background: var(--violet); box-shadow: 0 0 30px var(--violet); z-index: 2; }
  .card:hover .r1 { transform: scale(1.28); border-color: var(--cyan); }
  .card:hover .r2 { transform: scale(.82); border-color: var(--violet); }
  .card:hover .r3 { transform: scale(1.12); border-color: var(--coral); }
  .finale { min-height: 90svh; position: relative; display: grid; place-items: center; overflow: hidden; border-top: 1px solid rgba(255,255,255,.1); background: #05060a; }
  .finale-glow { position: absolute; left: 50%; top: 50%; width: min(85vw, 980px); aspect-ratio: 1; transform: translate(-50%,-50%); border-radius: 50%; background: radial-gradient(circle at 45% 45%, rgba(255,255,255,.13), transparent 8%), radial-gradient(circle at 50% 50%, rgba(99,238,228,.15), rgba(154,124,255,.12) 28%, rgba(255,118,90,.06) 48%, transparent 70%); filter: blur(8px); animation: breathe 5s ease-in-out infinite alternate; }
  .finale-inner { position: relative; z-index: 1; text-align: center; }
  .finale .eyebrow { margin: 0 0 24px; }

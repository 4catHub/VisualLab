---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Afterimage — VisualLab"
  description="A kinetic typography experiment built from color, rhythm, and lingering motion."
  className="afterimage-page"
>
  <main class="stage" id="stage">
    <header class="topbar shell">
      <a href="/" class="back">← VisualLab</a>
      <span>AFTERIMAGE / 001</span>
      <button id="shuffleButton" type="button">SHIFT</button>
    </header>

    <section class="hero shell" aria-labelledby="title">
      <div class="copy">
        <p class="eyebrow">Kinetic type study</p>
        <h1 id="title" aria-label="Afterimage">
          <span class="word word-a">AFTER</span>
          <span class="word word-b">IMAGE</span>
        </h1>
        <p class="lede">색은 먼저 지나가고, 글자는 조금 늦게 따라옵니다. 움직인 뒤에 남는 순간을 화면 위에 겹쳐 놓은 작은 실험입니다.</p>
      </div>

      <div class="poster" id="poster" aria-hidden="true">
        <div class="poster-grid"></div>
        <span class="ghost ghost-a">A</span>
        <span class="ghost ghost-b">F</span>
        <span class="ghost ghost-c">T</span>
        <span class="ghost ghost-d">R</span>
        <div class="disc disc-a"></div>
        <div class="disc disc-b"></div>
        <div class="slash slash-a"></div>
        <div class="slash slash-b"></div>
        <div class="orbit-copy orbit-1">MOVE · HOLD · FADE ·</div>
        <div class="orbit-copy orbit-2">MOVE · HOLD · FADE ·</div>
      </div>
    </section>

    <section class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span>COLOR</span><i>—</i><span>RHYTHM</span><i>—</i><span>TYPE</span><i>—</i><span>MOTION</span><i>—</i>
        <span>COLOR</span><i>—</i><span>RHYTHM</span><i>—</i><span>TYPE</span><i>—</i><span>MOTION</span><i>—</i>
      </div>
    </section>

    <section class="echo shell">
      <p class="eyebrow">Leave a trace</p>
      <div class="echo-line" id="echoLine">
        <span>MOVE</span><span>SLOW</span><span>ENOUGH</span><span>TO</span><span>SEE</span><span>IT.</span>
      </div>
      <p class="hint">Move anywhere. Click or press SHIFT to change the composition.</p>
    </section>

    <footer class="shell footer">
      <a href="/">Index</a>
      <span>VisualLab · 001</span>
    </footer>
  </main>

  <script>
    const stage = document.querySelector<HTMLElement>('#stage');
    const poster = document.querySelector<HTMLElement>('#poster');
    const shuffleButton = document.querySelector<HTMLButtonElement>('#shuffleButton');
    const echoWords = [...document.querySelectorAll<HTMLElement>('#echoLine span')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let phase = 0;
    let palette = 0;

    const palettes = [
      ['#ff5d73', '#7856ff', '#64f2d1'],
      ['#ffba49', '#ff5ea8', '#5f7cff'],
      ['#5ce1e6', '#b579ff', '#ff775f'],
      ['#d9ff5f', '#4f64ff', '#ff6e5b']
    ];

    function applyPalette() {
      if (!stage) return;
      const p = palettes[palette % palettes.length] ?? palettes[0];
      stage.style.setProperty('--c1', p[0]);
      stage.style.setProperty('--c2', p[1]);
      stage.style.setProperty('--c3', p[2]);
      palette += 1;
      phase += 1;
      poster?.style.setProperty('--turn', `${phase * 17}deg`);
      echoWords.forEach((word, index) => {
        word.style.setProperty('--delay', `${index * 42}ms`);
        word.classList.remove('jump');
        requestAnimationFrame(() => word.classList.add('jump'));
      });
    }

    function setPointer(clientX: number, clientY: number) {
      tx = (clientX / window.innerWidth - .5) * 2;
      ty = (clientY / window.innerHeight - .5) * 2;
    }

    function animate() {
      x += (tx - x) * .055;
      y += (ty - y) * .055;
      stage?.style.setProperty('--mx', x.toFixed(4));
      stage?.style.setProperty('--my', y.toFixed(4));
      requestAnimationFrame(animate);
    }

    window.addEventListener('pointermove', (event) => setPointer(event.clientX, event.clientY), { passive: true });
    window.addEventListener('pointerleave', () => { tx = 0; ty = 0; });
    stage?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a,button')) return;
      applyPalette();
    });
    shuffleButton?.addEventListener('click', applyPalette);

    applyPalette();
    if (!reducedMotion) animate();
  </script>

  <style>
    :global(.afterimage-page) {
      background: #f1eee6;
      color: #121212;
      overflow-x: hidden;
    }

    .stage {
      --c1: #ff5d73;
      --c2: #7856ff;
      --c3: #64f2d1;
      --mx: 0;
      --my: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at calc(22% + var(--mx) * 6%) calc(22% + var(--my) * 5%), color-mix(in srgb, var(--c1) 27%, transparent), transparent 24%),
        radial-gradient(circle at calc(82% - var(--mx) * 7%) calc(78% - var(--my) * 6%), color-mix(in srgb, var(--c3) 24%, transparent), transparent 28%),
        #f1eee6;
      transition: background 1s ease;
    }

    .topbar {
      height: 84px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 1px solid rgba(0, 0, 0, .16);
      font-size: .64rem;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .back { justify-self: start; }
    .topbar > span { justify-self: center; }
    .topbar button {
      justify-self: end;
      border: 0;
      padding: 0;
      background: none;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      cursor: pointer;
    }

    .hero {
      min-height: calc(100vh - 84px);
      display: grid;
      grid-template-columns: .86fr 1.14fr;
      gap: clamp(38px, 6vw, 90px);
      align-items: center;
      padding-top: 56px;
      padding-bottom: 72px;
    }

    .copy { position: relative; z-index: 3; }
    .eyebrow {
      color: #111;
      font-size: .62rem;
      letter-spacing: .16em;
    }

    h1 {
      position: relative;
      margin: 24px 0 32px;
      font-size: clamp(5rem, 10.5vw, 11.5rem);
      line-height: .72;
      letter-spacing: -.095em;
      font-weight: 860;
    }

    .word { display: block; position: relative; }
    .word-a {
      transform: translate3d(calc(var(--mx) * 18px), calc(var(--my) * 8px), 0);
      text-shadow: calc(var(--mx) * -13px) calc(var(--my) * -8px) 0 var(--c1);
    }
    .word-b {
      color: transparent;
      -webkit-text-stroke: 2px #111;
      transform: translate3d(calc(var(--mx) * -25px), calc(var(--my) * -12px), 0);
      text-shadow: calc(var(--mx) * 16px) calc(var(--my) * 10px) 0 var(--c2);
    }

    .lede {
      max-width: 440px;
      margin: 0;
      font-size: .95rem;
      line-height: 1.8;
      color: rgba(18, 18, 18, .63);
    }

    .poster {
      --turn: 0deg;
      position: relative;
      height: min(70vw, 690px);
      max-height: 690px;
      min-height: 520px;
      overflow: hidden;
      border: 1px solid rgba(0, 0, 0, .18);
      background: #101010;
      box-shadow: 0 30px 90px rgba(35, 28, 60, .13);
    }

    .poster-grid {
      position: absolute;
      inset: 0;
      opacity: .17;
      background-image:
        linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
      background-size: 12.5% 12.5%;
    }

    .ghost {
      position: absolute;
      z-index: 2;
      font-size: clamp(11rem, 24vw, 24rem);
      font-weight: 900;
      line-height: .7;
      letter-spacing: -.1em;
      mix-blend-mode: screen;
      transition: color .8s ease;
    }
    .ghost-a { left: -4%; top: 6%; color: var(--c1); transform: translate3d(calc(var(--mx) * 34px), calc(var(--my) * 28px),0); }
    .ghost-b { right: -2%; top: 19%; color: var(--c2); transform: translate3d(calc(var(--mx) * -46px), calc(var(--my) * -20px),0) rotate(8deg); }
    .ghost-c { left: 14%; bottom: -3%; color: var(--c3); transform: translate3d(calc(var(--mx) * 55px), calc(var(--my) * -35px),0) rotate(-11deg); }
    .ghost-d { right: 8%; bottom: -10%; color: white; opacity: .38; transform: translate3d(calc(var(--mx) * -20px), calc(var(--my) * 30px),0); }

    .disc {
      position: absolute;
      z-index: 4;
      border-radius: 50%;
      transition: background .8s ease;
      mix-blend-mode: difference;
    }
    .disc-a { width: 180px; aspect-ratio: 1; left: 10%; top: 42%; background: var(--c3); transform: translate3d(calc(var(--mx) * -28px), calc(var(--my) * 22px),0); }
    .disc-b { width: 74px; aspect-ratio: 1; right: 18%; top: 12%; background: var(--c1); transform: translate3d(calc(var(--mx) * 42px), calc(var(--my) * -34px),0); }

    .slash {
      position: absolute;
      z-index: 5;
      height: 2px;
      width: 56%;
      background: white;
      transform-origin: center;
      opacity: .8;
    }
    .slash-a { left: 24%; top: 52%; transform: rotate(calc(-26deg + var(--turn))) translateX(calc(var(--mx) * 12px)); }
    .slash-b { left: 11%; top: 64%; width: 78%; transform: rotate(calc(17deg - var(--turn))) translateX(calc(var(--my) * 18px)); }

    .orbit-copy {
      position: absolute;
      z-index: 7;
      color: white;
      font-size: .58rem;
      letter-spacing: .25em;
      white-space: nowrap;
      opacity: .7;
    }
    .orbit-1 { left: 24px; bottom: 22px; }
    .orbit-2 { right: 20px; top: 20px; writing-mode: vertical-rl; }

    .ticker {
      overflow: hidden;
      border-top: 1px solid rgba(0,0,0,.18);
      border-bottom: 1px solid rgba(0,0,0,.18);
      background: #111;
      color: #f1eee6;
    }
    .ticker-track {
      display: flex;
      width: max-content;
      gap: 32px;
      align-items: center;
      padding: 19px 0;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .18em;
      animation: ticker 20s linear infinite;
    }
    .ticker-track i { color: var(--c3); font-style: normal; }

    .echo {
      min-height: 82vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 100px;
      padding-bottom: 100px;
    }
    .echo-line {
      display: flex;
      flex-wrap: wrap;
      gap: 0 .21em;
      margin: 32px 0 40px;
      max-width: 1100px;
      font-size: clamp(3.2rem, 8vw, 8.5rem);
      font-weight: 840;
      line-height: .85;
      letter-spacing: -.07em;
    }
    .echo-line span:nth-child(even) { color: transparent; -webkit-text-stroke: 1.5px #111; }
    .echo-line span.jump { animation: jump .65s cubic-bezier(.2,.8,.2,1) var(--delay) both; }
    .hint { color: rgba(18,18,18,.48); font-size: .72rem; letter-spacing: .07em; }

    .footer {
      min-height: 90px;
      border-top: 1px solid rgba(0,0,0,.16);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .62rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    @keyframes ticker { to { transform: translateX(-50%); } }
    @keyframes jump {
      0% { transform: translateY(0); }
      35% { transform: translateY(-.12em) rotate(-2deg); color: var(--c1); }
      100% { transform: translateY(0); }
    }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .poster { height: 72vh; min-height: 500px; }
      .topbar { grid-template-columns: 1fr 1fr; }
      .topbar > span { display: none; }
    }

    @media (max-width: 560px) {
      .hero { padding-top: 78px; }
      .poster { min-height: 430px; }
      .disc-a { width: 120px; }
      .echo { min-height: 72vh; }
    }

    @media (prefers-reduced-motion: reduce) {
      .ticker-track { animation: none; }
      .word, .ghost, .disc { transform: none !important; }
    }
  </style>
</BaseLayout>
